#!/usr/bin/env bash

set -euo pipefail

cd /opt/pwn.college

action="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi

if [ -f /data/config.env ]; then
    . /data/config.env
fi

ctfd_source="${DOJO_CTFD_SOURCE:-/opt/CTFd}"

database_host="${DB_HOST:-/run/postgresql}"
database_port=5432
if [[ "$database_host" =~ ^\[([^]]+)\]:([0-9]+)$ ]]; then
    database_port="${BASH_REMATCH[2]}"
    database_host="${BASH_REMATCH[1]}"
elif [[ "$database_host" =~ ^([^:/]+):([0-9]+)$ ]]; then
    database_port="${BASH_REMATCH[2]}"
    database_host="${BASH_REMATCH[1]}"
fi

database_args=(
    --host="$database_host"
    --port="$database_port"
    --username="${DB_USER:-ctfd}"
    --dbname="${DB_NAME:-ctfd}"
)

journal_units=(
    -u 'dojo-*'
    -u cadvisor.service
    -u docker.service
    -u grafana.service
    -u pgbouncer.service
    -u postgresql.service
    -u prometheus.service
    -u prometheus-node-exporter.service
    -u redis-dojo.service
    -u splunk.service
    -u sshd.service
)

case "$action" in
    init)
        exec /init
        ;;

    up)
        if [ -n "${DOCKER_USERNAME:-}" ] && [ -n "${DOCKER_TOKEN:-}" ]; then
            printf '%s' "$DOCKER_TOKEN" | docker login --username "$DOCKER_USERNAME" --password-stdin
        fi
        exec "$0" sync "$@"
        ;;

    update)
        git pull
        exec "$0" up "$@"
        ;;

    sync)
        exec nixos-rebuild switch --flake /opt/pwn.college#dojo "$@"
        ;;

    enter)
        container_user=1000
        if [ "${1:-}" = "-s" ]; then
            container_user=0
            shift
        fi
        if [ "$#" -eq 0 ]; then
            echo "Usage: $0 enter [ -s ] USER_ID [ COMMAND ... ]" >&2
            exit 1
        fi

        dojo_uid="$1"
        shift
        if [[ "$dojo_uid" =~ [^0-9] ]]; then
            dojo_uid="$(printf "select id from users where name='%s'" "${dojo_uid//\'/\'\'}" | "$0" db -qAt)"
        fi
        if [ -z "$dojo_uid" ]; then
            echo "Error: user not found" >&2
            exit 1
        fi

        container="user_$dojo_uid"
        exec_args=(-i)
        if [ -t 0 ] && [ -t 1 ]; then
            exec_args+=(-t)
        fi
        if [ "$#" -eq 0 ]; then
            set -- bash
        fi

        nodes=(unix:///var/run/docker.sock)
        if command -v wg >/dev/null && wg show wg0 >/dev/null 2>&1; then
            while IFS= read -r node_ip; do
                nodes+=("tcp://${node_ip}:2375")
            done < <(
                wg show wg0 allowed-ips |
                    awk '{print $2}' |
                    tr ',' '\n' |
                    sed -nE 's|^(192\.168\.42\.[0-9]+)/32$|\1|p'
            )
        fi

        for node in "${nodes[@]}"; do
            if [ "$(docker -H "$node" inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)" = "true" ]; then
                exec docker -H "$node" exec "${exec_args[@]}" --user "$container_user" "$container" "$@"
            fi
        done
        echo "Error: no running container for $container" >&2
        exit 1
        ;;

    node)
        exec dojo-node "$@"
        ;;

    flask)
        if [ "$EUID" -eq 0 ]; then
            exec /run/current-system/sw/bin/setpriv \
                --reuid=ctfd \
                --regid=ctfd \
                --init-groups \
                --inh-caps=-all \
                --ambient-caps=-all \
                --bounding-set=-all \
                /run/current-system/sw/bin/dojo-flask shell "$@"
        fi
        exec /run/current-system/sw/bin/dojo-flask shell "$@"
        ;;

    db)
        PGPASSWORD="${DB_PASS:-ctfd}" exec psql "${database_args[@]}" "$@"
        ;;

    backup)
        umask 077
        mkdir -p /data/backups
        backup_path="/data/backups/db-$(date -Iseconds).dump"
        PGPASSWORD="${DB_PASS:-ctfd}" pg_dump "${database_args[@]}" --format=custom --file="$backup_path"
        echo "Created backup at $backup_path"
        ;;

    restore)
        if [ "$#" -ne 1 ]; then
            echo "Usage: $0 restore PATH" >&2
            exit 1
        fi
        backup_path="/data/backups/$1"
        if [ ! -f "$backup_path" ]; then
            echo "Error: missing file to restore from" >&2
            exit 1
        fi
        PGPASSWORD="${DB_PASS:-ctfd}" pg_restore \
            "${database_args[@]}" \
            --clean \
            --if-exists \
            "$backup_path"
        ;;

    cloud-backup)
        if [ -z "${BACKUP_AES_KEY_FILE:-}" ]; then
            echo "To use cloud backup, BACKUP_AES_KEY_FILE must be set" >&2
            exit 1
        fi
        if [ ! -f "$BACKUP_AES_KEY_FILE" ]; then
            echo "To use cloud backup, BACKUP_AES_KEY_FILE must name a file, but is $BACKUP_AES_KEY_FILE instead" >&2
            exit 1
        fi
        if [ -z "${S3_BACKUP_BUCKET:-}" ]; then
            echo "To use cloud backup, S3_BACKUP_BUCKET must be set to the S3 bucket to use" >&2
            exit 1
        fi

        while IFS= read -r -d '' backup_file; do
            backup_filename="$(basename "$backup_file").enc"
            output_file="$(mktemp "/tmp/${backup_filename}.XXXXXX")"
            trap 'rm -f "$output_file"' EXIT
            openssl enc \
                -in "$backup_file" \
                -out "$output_file" \
                -e \
                -aes256 \
                -pbkdf2 \
                -kfile "$BACKUP_AES_KEY_FILE"
            echo "Created encrypted $output_file"
            AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-}" \
                AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-}" \
                AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-}" \
                aws s3 cp "$output_file" "s3://$S3_BACKUP_BUCKET/$backup_filename"
            echo "Backed up $output_file to S3 bucket $S3_BACKUP_BUCKET"
            rm -f "$output_file"
            trap - EXIT
        done < <(find /data/backups -mtime -1 -type f -print0)
        ;;

    vscode)
        exec dojo-vscode "$@"
        ;;

    logs)
        exec journalctl --no-pager "${journal_units[@]}" "$@"
        ;;

    load-dojo)
        exec "$0" flask -- "$ctfd_source/CTFd/plugins/dojo_plugin/scripts/load_dojo.py" -- "$@"
        ;;

    wait)
        journalctl --no-pager -f --no-tail --since '-5 min' "${journal_units[@]}" &
        logs_pid=$!
        trap 'kill "$logs_pid" 2>/dev/null || true' EXIT

        wait_timeout="${DOJO_WAIT_TIMEOUT:-1800}"
        if timeout --foreground "${wait_timeout}s" systemctl restart dojo-ready.service; then
            wait_status=0
        else
            wait_status=$?
        fi

        kill "$logs_pid" 2>/dev/null || true
        wait "$logs_pid" 2>/dev/null || true
        trap - EXIT
        if [ "$wait_status" -eq 124 ]; then
            systemctl stop dojo-ready.service 2>/dev/null || true
            echo "Error: timed out waiting for dojo-ready.target" >&2
            exit 1
        fi
        if [ "$wait_status" -ne 0 ]; then
            echo "Error: dojo readiness check failed" >&2
            systemctl --no-pager --failed \
                'dojo-*' \
                cadvisor.service \
                docker.service \
                grafana.service \
                pgbouncer.service \
                postgresql.service \
                prometheus.service \
                prometheus-node-exporter.service \
                redis-dojo.service \
                splunk.service \
                sshd.service >&2 || true
            exit "$wait_status"
        fi
        ;;

    help)
        cat <<EOF
Usage: $0 COMMAND [ ARG ... ]

COMMANDS:

    init: start the NixOS init system when dojo is used as the outer image entrypoint
    up: rebuild the NixOS system and switch to it
    update: pull the repository, rebuild the NixOS system, and switch to it
    sync: rebuild the NixOS system from /opt/pwn.college and switch to it
    enter [ -s ] USER_ID [ COMMAND ... ]: enter a user's running container; -s enters as root
    node: run a dojo node command
    flask: run a Flask shell through the native dojo environment
    db: launch a PostgreSQL client connected to the dojo database
    backup: create a database backup in /data/backups
    restore PATH: restore a database backup relative to /data/backups
    cloud-backup: encrypt and upload recent backups to S3
    vscode: start a VS Code tunnel
    logs: display logs for native dojo services
    load-dojo: load a dojo from a git repository
    wait: wait for dojo-ready.target
    help: display this help
EOF
        ;;

    *)
        echo "Unknown command: $action" >&2
        echo >&2
        "$0" help >&2
        exit 1
        ;;
esac
