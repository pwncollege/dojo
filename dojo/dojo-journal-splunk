#!/usr/bin/env python3

import json
import os
import subprocess
import time

import requests


token = "11111111-1111-1111-1111-111111111111"
node = os.environ.get("WORKSPACE_NODE", "0")
host = "127.0.0.1" if node == "0" else "192.168.42.1"
event_url = f"http://{host}:8088/services/collector/event"
health_url = f"http://{host}:8088/services/collector/health"
headers = {"Authorization": f"Splunk {token}"}

while True:
    try:
        if requests.get(health_url, headers=headers, timeout=5).ok:
            break
    except requests.RequestException:
        pass
    time.sleep(2)

process = subprocess.Popen(
    ["journalctl", "--follow", "--output=json", "--since=-5min"],
    stdout=subprocess.PIPE,
    text=True,
)
for line in process.stdout:
    try:
        entry = json.loads(line)
        timestamp = int(entry.get("__REALTIME_TIMESTAMP", 0)) / 1_000_000
        event = {
            "time": timestamp or time.time(),
            "host": f"node-{node}-{entry.get('_HOSTNAME', 'unknown')}",
            "source": "systemd-journal",
            "sourcetype": "systemd",
            "event": entry,
        }
        requests.post(event_url, json=event, headers=headers, timeout=5).raise_for_status()
    except (ValueError, requests.RequestException) as error:
        print(error, flush=True)

raise SystemExit(process.wait())
