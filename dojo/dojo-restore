class RestoreError(RuntimeError):
    pass


class RestoreInterrupted(RestoreError):
    pass


class LoopbackHTTPSConnection(http.client.HTTPSConnection):
    def connect(self):
        self.sock = socket.create_connection(
            ("127.0.0.1", self.port),
            self.timeout,
            self.source_address,
        )
        try:
            self.sock = self._context.wrap_socket(
                self.sock,
                server_hostname=self.host,
            )
        except BaseException:
            self.sock.close()
            self.sock = None
            raise


def validate_server_identity(identity):
    if not isinstance(identity, dict) or set(identity) != {
        "system_identifier",
        "server_version_num",
    }:
        raise RestoreError("restore journal has an invalid PostgreSQL server identity")
    system_identifier = identity["system_identifier"]
    if (
        not isinstance(system_identifier, str)
        or not system_identifier.isdecimal()
        or not 1 <= int(system_identifier) <= 0xFFFFFFFFFFFFFFFF
    ):
        raise RestoreError("restore journal has an invalid PostgreSQL system identifier")
    if (
        type(identity["server_version_num"]) is not int
        or not 90_000 <= identity["server_version_num"] <= 9_999_999
    ):
        raise RestoreError("restore journal has an invalid PostgreSQL server version")
    if identity["server_version_num"] // 10_000 != SUPPORTED_POSTGRES_MAJOR:
        raise RestoreError(
            f"PostgreSQL {SUPPORTED_POSTGRES_MAJOR} is required for database restore"
        )


def database_host_is_dns_name(host):
    try:
        ipaddress.ip_address(host)
    except ValueError:
        pass
    else:
        return False
    if len(host) > 253 or host.startswith(".") or host.endswith("."):
        return False
    labels = host.split(".")
    return all(
        label.isascii()
        and 1 <= len(label) <= 63
        and label[0].isalnum()
        and label[-1].isalnum()
        and all(character.isalnum() or character == "-" for character in label)
        for label in labels
    )


def validate_database_configuration(configuration):
    if not isinstance(configuration, dict) or set(configuration) != {
        "host",
        "port",
        "name",
        "user",
        "sslmode",
        "sslrootcert",
        "sslrootcert_sha256",
        "trusted_local",
    }:
        raise RestoreError("restore journal has an invalid database target")
    for field in ("host", "name", "user"):
        validate_text(configuration[field], f"target {field}", limit=1024)
    if (
        type(configuration["port"]) is not int
        or not 1 <= configuration["port"] <= 65535
    ):
        raise RestoreError("restore journal has an invalid database target port")
    if configuration["sslmode"] not in {"disable", "verify-full"}:
        raise RestoreError("restore journal has an invalid database TLS mode")
    if not isinstance(configuration["trusted_local"], bool):
        raise RestoreError("restore journal has an invalid database trust mode")
    if configuration["sslmode"] == "disable":
        if (
            not configuration["trusted_local"]
            or configuration["host"] not in TRUSTED_LOCAL_DATABASE_HOSTS
            or configuration["sslrootcert"] is not None
            or configuration["sslrootcert_sha256"] is not None
        ):
            raise RestoreError("restore journal has an unsafe local database target")
    else:
        validate_text(
            configuration["sslrootcert"],
            "TLS root certificate",
            limit=4096,
        )
        digest = configuration["sslrootcert_sha256"]
        if (
            configuration["trusted_local"]
            or not pathlib.PurePosixPath(configuration["sslrootcert"]).is_absolute()
            or not isinstance(digest, str)
            or len(digest) != 64
            or any(character not in "0123456789abcdef" for character in digest)
            or configuration["host"] in TRUSTED_LOCAL_DATABASE_HOSTS
            or not database_host_is_dns_name(configuration["host"])
        ):
            raise RestoreError("restore journal has an invalid verified database target")


def validate_database_target(target):
    if not isinstance(target, dict) or set(target) != {
        "host",
        "port",
        "name",
        "user",
        "sslmode",
        "sslrootcert",
        "sslrootcert_sha256",
        "trusted_local",
        "server",
    }:
        raise RestoreError("restore journal has an invalid database target")
    validate_database_configuration(
        {field: target[field] for field in target if field != "server"}
    )
    validate_server_identity(target["server"])


def validate_application_role(role):
