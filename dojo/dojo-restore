def scram_verifier(password):
    salt = secrets.token_bytes(16)
    iterations = 4096
    salted_password = hashlib.pbkdf2_hmac(
        "sha256",
        password.encode(),
        salt,
        iterations,
    )
    client_key = hmac.new(salted_password, b"Client Key", hashlib.sha256).digest()
    stored_key = hashlib.sha256(client_key).digest()
    server_key = hmac.new(salted_password, b"Server Key", hashlib.sha256).digest()
    return (
        f"SCRAM-SHA-256${iterations}:"
        f"{base64.b64encode(salt).decode()}$"
        f"{base64.b64encode(stored_key).decode()}:"
        f"{base64.b64encode(server_key).decode()}"
    )


def open_managed_directory(path, *, create, mode, owner_uid, exact_mode, error):
    path = pathlib.Path(path)
    if path.name in {"", ".", ".."}:
        raise RestoreError(error)
    parent_descriptor = None
    directory_descriptor = None
    created = False
    try:
        parent_descriptor = os.open(
            path.parent,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
        )
        if create:
            try:
                os.mkdir(path.name, mode, dir_fd=parent_descriptor)
                created = True
            except FileExistsError:
                pass
            if created:
                os.chmod(
                    path.name,
                    mode,
                    dir_fd=parent_descriptor,
                    follow_symlinks=False,
                )
        directory_descriptor = os.open(
            path.name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent_descriptor,
        )
        if created:
            os.fchmod(directory_descriptor, mode)
        directory_stat = os.fstat(directory_descriptor)
        trusted_mode = (
            stat.S_IMODE(directory_stat.st_mode) == mode
            if exact_mode
            else not directory_stat.st_mode & 0o022
        )
        if (
            not stat.S_ISDIR(directory_stat.st_mode)
            or directory_stat.st_uid != owner_uid
            or not trusted_mode
        ):
            raise RestoreError(error)
        if created:
            os.fsync(directory_descriptor)
        os.fsync(parent_descriptor)
        return directory_descriptor
    except FileNotFoundError:
        if not create:
            return None
        raise RestoreError(error)
    except RestoreError:
        raise
    except OSError as caught:
        raise RestoreError(error) from caught
    finally:
        if directory_descriptor is not None and (
            sys.exc_info()[0] is not None
        ):
            os.close(directory_descriptor)
        if parent_descriptor is not None:
            os.close(parent_descriptor)


def pause_for_test(point):
    pause_points = {
        value.strip()
        for value in (
            os.environ.get("DOJO_RESTORE_TEST_PAUSE_POINTS", "")
            + ","
            + os.environ.get("DOJO_RESTORE_TEST_PAUSE_PHASES", "")
        ).split(",")
        if value.strip()
    }
    if point in pause_points:
        os.kill(os.getpid(), signal.SIGSTOP)


class CommandRunner:
    def __init__(self):
        self.process = None

    def run(
        self,
        arguments,
        *,
        stdin=None,
        stdout=None,
        capture_output=False,
        check=True,
        timeout=DEFAULT_READY_TIMEOUT,
        environment=None,
    ):
        if capture_output and stdout is not None:
            raise ValueError("stdout and capture_output cannot be combined")
        process = subprocess.Popen(
            arguments,
            stdin=stdin,
            stdout=subprocess.PIPE if capture_output else stdout,
            stderr=subprocess.PIPE,
            env=environment,
            start_new_session=True,
        )
        self.process = process
        try:
            process_stdout, process_stderr = process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired as error:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(process.pid, signal.SIGKILL)
            process.wait()
            raise RestoreError(
                f"command timed out after {timeout} seconds: {' '.join(arguments)}"
            ) from error
        except BaseException:
            if process.poll() is None:
                with contextlib.suppress(ProcessLookupError):
                    os.killpg(process.pid, signal.SIGKILL)
                process.wait()
            raise
        finally:
            self.process = None
        result = subprocess.CompletedProcess(
            arguments,
            process.returncode,
            process_stdout,
            process_stderr,
        )
        if check and result.returncode:
            error = (process_stderr or b"").decode(errors="replace")[-8000:]
            raise RestoreError(
                f"command failed ({result.returncode}): {' '.join(arguments)}\n{error}"
            )
        return result

    def interrupt(self):
        if self.process is not None and self.process.poll() is None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(self.process.pid, signal.SIGKILL)


def database_tls_root_certificate_digest(path):
    certificate_path = pathlib.PurePosixPath(path)
    tls_directory = pathlib.PurePosixPath(DATABASE_TLS_DIRECTORY)
    if (
        not certificate_path.is_absolute()
        or certificate_path.parent != tls_directory
        or certificate_path.name in {"", ".", ".."}
    ):
        raise RestoreError(
            f"database TLS root certificate must be directly beneath {tls_directory}"
        )
    directory_descriptor = open_managed_directory(
        DATABASE_TLS_DIRECTORY,
        create=False,
        mode=0o755,
        owner_uid=DATABASE_TLS_OWNER_UID,
        exact_mode=False,
        error=(
            "database TLS directory must be a root-owned non-writable directory: "
            f"{DATABASE_TLS_DIRECTORY}"
        ),
    )
    if directory_descriptor is None:
        raise RestoreError("configured database TLS directory does not exist")
    try:
        descriptor = os.open(
            certificate_path.name,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
            dir_fd=directory_descriptor,
        )
    except OSError as error:
        raise RestoreError(
            "could not open the configured database TLS root certificate"
        ) from error
    finally:
        os.close(directory_descriptor)
    try:
        file_stat = os.fstat(descriptor)
        if (
            not stat.S_ISREG(file_stat.st_mode)
            or file_stat.st_uid != DATABASE_TLS_OWNER_UID
            or file_stat.st_mode & 0o022
            or not 0 < file_stat.st_size <= DATABASE_TLS_ROOT_CERT_LIMIT
        ):
            raise RestoreError(
                "database TLS root certificate must be a trusted read-only regular file"
            )
        contents = bytearray()
        while len(contents) <= DATABASE_TLS_ROOT_CERT_LIMIT:
            chunk = os.read(
                descriptor,
                min(65536, DATABASE_TLS_ROOT_CERT_LIMIT + 1 - len(contents)),
            )
            if not chunk:
                break
            contents.extend(chunk)
        if len(contents) != file_stat.st_size:
            raise RestoreError("database TLS root certificate changed while being read")
    finally:
        os.close(descriptor)
    return hashlib.sha256(contents).hexdigest()


class DatabaseTarget:
    def __init__(
        self,
        host,
        port,
        name,
        user,
        password,
        *,
        sslmode="disable",
        sslrootcert=None,
        trusted_local=True,
        sslrootcert_sha256=None,
    ):
        for value, field in ((host, "host"), (name, "name"), (user, "user")):
            if (
                not isinstance(value, str)
                or not value
                or "\x00" in value
                or len(value.encode()) > 1024
            ):
                raise RestoreError(f"invalid configured database {field}")
        try:
            port = int(port)
        except (TypeError, ValueError) as error:
            raise RestoreError("configured database port must be an integer") from error
        if not 1 <= port <= 65535:
            raise RestoreError("configured database port must be between 1 and 65535")
        if not isinstance(password, str) or "\x00" in password:
            raise RestoreError("invalid configured database password")
        if name in {"postgres", "template0", "template1"}:
            raise RestoreError(
                "restore database must not be a PostgreSQL maintenance database"
            )
        self.host = host
        self.port = port
        self.name = name
        self.user = user
        self.password = password
        if sslmode not in {"disable", "verify-full"}:
            raise RestoreError(
                "configured database TLS mode must be disable or verify-full"
            )
        if not isinstance(trusted_local, bool):
            raise RestoreError("configured database trust mode must be boolean")
        if sslmode == "disable":
            if not trusted_local or host not in TRUSTED_LOCAL_DATABASE_HOSTS:
                raise RestoreError(
                    "unencrypted PostgreSQL is restricted to explicitly trusted local hosts"
                )
            if sslrootcert not in {None, ""} or sslrootcert_sha256 is not None:
                raise RestoreError(
                    "trusted local PostgreSQL must not configure a TLS root certificate"
                )
            sslrootcert = None
            root_certificate_digest = None
        else:
            if trusted_local:
                raise RestoreError(
                    "verified PostgreSQL TLS must not use trusted-local mode"
                )
            if host in TRUSTED_LOCAL_DATABASE_HOSTS or not database_host_is_dns_name(host):
                raise RestoreError(
                    "verified PostgreSQL TLS requires its certificate hostname"
                )
            if (
                not isinstance(sslrootcert, str)
                or not pathlib.PurePosixPath(sslrootcert).is_absolute()
            ):
                raise RestoreError(
                    "verified PostgreSQL TLS requires an absolute root certificate path"
                )
            root_certificate_digest = database_tls_root_certificate_digest(sslrootcert)
            if (
                sslrootcert_sha256 is not None
                and not hmac.compare_digest(
                    root_certificate_digest,
                    sslrootcert_sha256,
                )
            ):
                raise RestoreError("database TLS root certificate identity changed")
        self.sslmode = sslmode
        self.sslrootcert = sslrootcert
        self.sslrootcert_sha256 = root_certificate_digest
        self.trusted_local = trusted_local

    @classmethod
    def from_environment(cls):
        trusted_local = os.environ.get("DB_TRUSTED_LOCAL")
        if trusted_local not in {"true", "false"}:
            raise RestoreError(
                "DB_TRUSTED_LOCAL must explicitly be true or false"
            )
        return cls(
            os.environ.get("DB_HOST", "db"),
            os.environ.get("DB_PORT", "5432"),
            os.environ.get("DB_NAME", "ctfd"),
            os.environ.get("DB_USER", "ctfd"),
            os.environ.get("DB_PASS", "ctfd"),
            sslmode=os.environ.get("DB_SSLMODE", ""),
            sslrootcert=os.environ.get("DB_SSLROOTCERT") or None,
            trusted_local=trusted_local == "true",
        )

    def configuration(self):
        return {
            "host": self.host,
            "port": self.port,
            "name": self.name,
            "user": self.user,
            "sslmode": self.sslmode,
            "sslrootcert": self.sslrootcert,
            "sslrootcert_sha256": self.sslrootcert_sha256,
            "trusted_local": self.trusted_local,
        }

    def journal_target(self, server_identity):
        validate_server_identity(server_identity)
        return {**self.configuration(), "server": server_identity}

    def matches(self, journal_target):
        validate_database_target(journal_target)
        return self.configuration() == {
            field: journal_target[field]
            for field in self.configuration()
        }

    def database_url(self):
        user = urllib.parse.quote(self.user, safe="")
        password = urllib.parse.quote(self.password, safe="")
        database = urllib.parse.quote(self.name, safe="")
        host = urllib.parse.quote(self.host, safe="")
        if ":" in self.host:
            host = f"[{urllib.parse.quote(self.host, safe=':')}]"
        base_url = (
            f"postgresql+psycopg2://{user}:{password}@{host}:{self.port}/{database}"
        )
        parameters = {"sslmode": self.sslmode}
        if self.sslrootcert is not None:
            parameters["sslrootcert"] = self.sslrootcert
        return f"{base_url}?{urllib.parse.urlencode(parameters)}"

    def with_credentials(self, user, password):
        return DatabaseTarget(
            self.host,
            self.port,
            self.name,
            user,
            password,
            sslmode=self.sslmode,
            sslrootcert=self.sslrootcert,
            trusted_local=self.trusted_local,
            sslrootcert_sha256=self.sslrootcert_sha256,
        )

    def with_database(self, name):
        return DatabaseTarget(
            self.host,
            self.port,
            name,
            self.user,
            self.password,
            sslmode=self.sslmode,
            sslrootcert=self.sslrootcert,
            trusted_local=self.trusted_local,
            sslrootcert_sha256=self.sslrootcert_sha256,
        )

    def verify_tls_material(self):
        if self.sslmode == "verify-full" and not hmac.compare_digest(
            database_tls_root_certificate_digest(self.sslrootcert),
            self.sslrootcert_sha256,
        ):
            raise RestoreError("database TLS root certificate identity changed")

    def run_client(
        self,
        runner,
        program,
        arguments=(),
        *,
        database=None,
        connect=False,
        application_name=None,
        input_stream=False,
        **options,
    ):
        if connect and application_name is None:
            raise RestoreError(
                "connected database maintenance clients require an application name"
            )
        timeout = options.pop("timeout", DEFAULT_READY_TIMEOUT)
        if timeout is None or timeout <= 0:
            raise RestoreError("database client command requires a positive timeout")
        timeout_seconds = max(1, int(timeout + 0.999))
        timeout_milliseconds = min(timeout_seconds * 1000, 2_147_483_647)
        self.verify_tls_material()
        command = [
            "docker",
            "exec",
            "-e",
            "PGPASSWORD",
            "-e",
            "PGCONNECT_TIMEOUT",
            "-e",
            "PGOPTIONS",
            "-e",
            "PGSSLMODE",
        ]
        environment = {
            **os.environ,
            "PGPASSWORD": self.password,
            "PGCONNECT_TIMEOUT": str(timeout_seconds),
            "PGOPTIONS": (
                f"-c statement_timeout={timeout_milliseconds} "
                f"-c lock_timeout={timeout_milliseconds}"
            ),
            "PGSSLMODE": self.sslmode,
        }
        if self.sslrootcert is not None:
            command.extend(("-e", "PGSSLROOTCERT"))
            environment["PGSSLROOTCERT"] = self.sslrootcert
        if application_name is not None:
            command.extend(("-e", "PGAPPNAME"))
            environment["PGAPPNAME"] = application_name
        if input_stream:
            command.append("-i")
        command.extend(
            (
                "db",
                "timeout",
                "--signal=TERM",
                f"--kill-after={COMMAND_TIMEOUT_GRACE}s",
                f"{timeout_seconds}s",
                program,
            )
        )
        if connect:
            command.extend(
                (
                    f"--host={self.host}",
                    f"--port={self.port}",
                    f"--username={self.user}",
                    f"--dbname={database or self.name}",
                )
            )
        command.extend(arguments)
        return runner.run(
            command,
            environment=environment,
            timeout=timeout + COMMAND_TIMEOUT_GRACE,
            **options,
        )


class RestoreState:
    def __init__(self):
        self.directory_fd = None
        self.lock_fd = None
        self.locked = False
        self.installation_id = None
        self.maintenance_secret = None

    def __enter__(self):
        try:
            self.directory_fd = open_managed_directory(
                STATE_DIRECTORY,
                create=True,
                mode=0o700,
                owner_uid=STATE_OWNER_UID,
                exact_mode=True,
                error=(
                    "restore state directory must be a root-owned 0700 directory: "
                    f"{STATE_DIRECTORY}"
                ),
            )
            self.lock_fd = self._open_regular("lock", os.O_RDWR | os.O_CREAT, 0o600)
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX)
            self.locked = True
            self._clean_partials()
            self.installation_id = self._load_or_create_value(
                INSTALLATION_ID_FILE,
                INSTALLATION_ID_LENGTH,
                lambda: secrets.token_hex(INSTALLATION_ID_LENGTH // 2),
            )
            validate_installation_id(self.installation_id)
            self.maintenance_secret = self._load_or_create_value(
                MAINTENANCE_SECRET_FILE,
                MAINTENANCE_SECRET_LENGTH,
                lambda: secrets.token_hex(MAINTENANCE_SECRET_LENGTH // 2),
            )
            if (
                len(self.maintenance_secret) != MAINTENANCE_SECRET_LENGTH
                or any(
                    character not in "0123456789abcdef"
                    for character in self.maintenance_secret
                )
            ):
                raise RestoreError("restore maintenance secret is invalid")
            return self
        except BaseException:
            self._close()
            raise

    def __exit__(self, _exception_type, _exception, _traceback):
        self._close()

    def _close(self):
        if self.lock_fd is not None:
            if self.locked:
                fcntl.flock(self.lock_fd, fcntl.LOCK_UN)
            os.close(self.lock_fd)
            self.lock_fd = None
            self.locked = False
        if self.directory_fd is not None:
            os.close(self.directory_fd)
            self.directory_fd = None
        self.installation_id = None
        self.maintenance_secret = None

    def _open_regular(self, name, flags, mode=0):
        descriptor = os.open(
            name,
            flags | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK,
            mode,
            dir_fd=self.directory_fd,
        )
        file_stat = os.fstat(descriptor)
        if (
            not stat.S_ISREG(file_stat.st_mode)
            or file_stat.st_uid != STATE_OWNER_UID
            or file_stat.st_mode & 0o077
        ):
            os.close(descriptor)
            raise RestoreError(f"untrusted restore state file: {name}")
        return descriptor

    def _clean_partials(self):
        for name in os.listdir(self.directory_fd):
            if name.startswith(".journal.") and name.endswith(".partial"):
                self._unlink_trusted(name)
            if name.startswith(".rollback.") and name.endswith(".partial"):
                self._unlink_trusted(name)
            if name.startswith(".identity.") and name.endswith(".partial"):
                self._unlink_trusted(name)

    def _unlink_trusted(self, name):
        descriptor = self._open_regular(name, os.O_RDONLY)
        os.close(descriptor)
        os.unlink(name, dir_fd=self.directory_fd)

    def _fsync_directory(self):
        os.fsync(self.directory_fd)

    def _load_or_create_value(self, name, length, generate):
        try:
            descriptor = self._open_regular(name, os.O_RDONLY)
        except FileNotFoundError:
            value = generate()
            payload = value.encode()
            temporary_name = f".identity.{os.getpid()}.{uuid.uuid4().hex}.partial"
            descriptor = self._open_regular(
                temporary_name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                0o600,
            )
            try:
                if os.write(descriptor, payload) != len(payload):
                    raise RestoreError("restore identity could not be written")
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
            os.replace(
                temporary_name,
                name,
                src_dir_fd=self.directory_fd,
                dst_dir_fd=self.directory_fd,
            )
            self._fsync_directory()
            return value
        try:
            file_stat = os.fstat(descriptor)
            if file_stat.st_size != length:
                raise RestoreError("restore identity has an invalid size")
            payload = os.read(descriptor, length + 1)
            if len(payload) != length:
                raise RestoreError("restore identity changed while being read")
        finally:
            os.close(descriptor)
        try:
            return payload.decode()
        except UnicodeDecodeError as error:
            raise RestoreError("restore identity is invalid") from error

    @property
    def maintenance_role(self):
        validate_installation_id(self.installation_id)
        return f"dojo_restore_{self.installation_id}"

    def load_journal(self):
        try:
            descriptor = self._open_regular("journal", os.O_RDONLY)
        except FileNotFoundError:
            return None
        try:
            file_stat = os.fstat(descriptor)
            if not 0 < file_stat.st_size <= JOURNAL_LIMIT:
                raise RestoreError("restore journal has an invalid size")
            payload = os.read(descriptor, JOURNAL_LIMIT + 1)
            if len(payload) != file_stat.st_size:
                raise RestoreError("restore journal changed while being read")
        finally:
            os.close(descriptor)
        try:
            journal = json.loads(payload)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("restore journal is invalid") from error
        self._validate_journal(journal)
        return journal

    def _validate_journal(self, journal):
        if not isinstance(journal, dict):
            raise RestoreError("restore journal has an invalid structure")
        version = journal.get("version")
        expected_fields = {
            1: {"version", "phase", "services", "database"},
            2: {"version", "phase", "services", "database", "target"},
            3: {
                "version",
                "phase",
                "services",
                "database",
                "target",
                "installation_id",
            },
            4: {
                "version",
                "phase",
                "services",
                "database",
                "target",
                "installation_id",
                "application_role",
            },
            5: {
                "version",
                "phase",
                "services",
                "database",
                "target",
                "installation_id",
                "application_role",
                "maintenance",
            },
            6: {
                "version",
                "kind",
                "services",
                "installation_id",
                "database",
                "target",
            },
        }
        if type(version) is not int or set(journal) != expected_fields.get(version):
            raise RestoreError("restore journal has an unsupported state")
        if version == 6:
            if journal["kind"] != "startup":
                raise RestoreError("restore journal has an unsupported state")
            validate_installation_id(journal["installation_id"])
            validate_database_configuration(journal["target"])
            database = journal["database"]
            if (
                not isinstance(database, dict)
                or set(database) != {"present", "running", "id"}
                or type(database["present"]) is not bool
                or type(database["running"]) is not bool
                or (
                    database["present"]
                    and (not isinstance(database["id"], str) or not database["id"])
                )
                or (
                    not database["present"]
                    and (database["running"] or database["id"] is not None)
                )
            ):
                raise RestoreError("restore journal has invalid startup database state")
        elif (
            not isinstance(journal["phase"], str)
            or journal["phase"] not in JOURNAL_PHASES
        ):
            raise RestoreError("restore journal has an unsupported state")
        services = journal["services"]
        if not isinstance(services, dict) or frozenset(services) not in {
            frozenset(SNAPSHOT_SERVICES),
            frozenset(LEGACY_SNAPSHOT_SERVICES),
        }:
            raise RestoreError("restore journal has an invalid service snapshot")
        if version != 1 and frozenset(services) == frozenset(
            LEGACY_SNAPSHOT_SERVICES
        ):
            raise RestoreError(
                "restore journal has an unsupported legacy service snapshot"
            )
        for name, service in services.items():
            if not isinstance(service, dict) or set(service) != {
                "id",
                "restart_policy",
                "restart_retries",
                "running",
                "status",
            }:
                raise RestoreError(f"restore journal has invalid state for {name}")
            if not isinstance(service["id"], str) or not service["id"]:
                raise RestoreError(f"restore journal has invalid identity for {name}")
            if not isinstance(service["running"], bool):
                raise RestoreError(f"restore journal has invalid lifecycle for {name}")
            if not isinstance(service["status"], str) or service["status"] not in (
                "running",
                "exited",
                "created",
            ):
                raise RestoreError(f"restore journal has invalid status for {name}")
            if (
                not isinstance(service["restart_policy"], str)
                or service["restart_policy"]
                not in {"no", "always", "unless-stopped", "on-failure"}
            ):
                raise RestoreError(f"restore journal has invalid restart policy for {name}")
            if (
                type(service["restart_retries"]) is not int
                or not 0 <= service["restart_retries"] <= 2_147_483_647
                or (
                    service["restart_policy"] != "on-failure"
                    and service["restart_retries"] != 0
                )
            ):
                raise RestoreError(f"restore journal has invalid restart count for {name}")
        if version == 6:
            return
        validate_database_metadata(journal["database"])
        if version in {2, 3, 4, 5}:
            validate_database_target(journal["target"])
        if version in {3, 4, 5}:
            validate_installation_id(journal["installation_id"])
        if version in {4, 5}:
            validate_application_role(journal["application_role"])
        if version == 5 and journal["maintenance"] not in MAINTENANCE_STATES:
            raise RestoreError("restore journal has an invalid maintenance state")

    def write_journal(self, journal):
        self._validate_journal(journal)
        payload = json.dumps(journal, sort_keys=True, separators=(",", ":")).encode()
        if not 0 < len(payload) <= JOURNAL_LIMIT:
            raise RestoreError("restore journal output has an invalid size")
        temporary_name = f".journal.{os.getpid()}.{uuid.uuid4().hex}.partial"
        descriptor = self._open_regular(
            temporary_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o600,
        )
        try:
            offset = 0
            while offset < len(payload):
                written = os.write(descriptor, payload[offset:])
                if written == 0:
                    raise RestoreError("restore journal could not be written")
                offset += written
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(
            temporary_name,
            "journal",
            src_dir_fd=self.directory_fd,
            dst_dir_fd=self.directory_fd,
        )
        self._fsync_directory()

    def set_phase(self, journal, phase):
        journal["phase"] = phase
        self.write_journal(journal)
        pause_for_test(phase)

    def set_maintenance(self, journal, maintenance):
        if maintenance not in MAINTENANCE_STATES:
            raise RestoreError("restore maintenance state is invalid")
        journal["maintenance"] = maintenance
        self.write_journal(journal)

    @contextlib.contextmanager
    def create_rollback(self):
        temporary_name = f".rollback.{os.getpid()}.{uuid.uuid4().hex}.partial"
        descriptor = self._open_regular(
            temporary_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o600,
        )
        try:
            yield descriptor
            os.fsync(descriptor)
            if os.fstat(descriptor).st_size == 0:
                raise RestoreError("rollback database dump is empty")
            os.replace(
                temporary_name,
                "rollback.dump",
                src_dir_fd=self.directory_fd,
                dst_dir_fd=self.directory_fd,
            )
            self._fsync_directory()
        finally:
            os.close(descriptor)
            try:
                os.unlink(temporary_name, dir_fd=self.directory_fd)
            except FileNotFoundError:
                pass

    @contextlib.contextmanager
    def open_rollback(self):
        descriptor = self._open_regular("rollback.dump", os.O_RDONLY)
        if os.fstat(descriptor).st_size == 0:
            os.close(descriptor)
            raise RestoreError("rollback database dump is empty")
        try:
            with os.fdopen(os.dup(descriptor), "rb") as rollback:
                yield rollback
        finally:
            os.close(descriptor)

    def cleanup(self):
        try:
            self._unlink_trusted("journal")
            self._fsync_directory()
        except FileNotFoundError:
            pass
        try:
            self._unlink_trusted("rollback.dump")
        except FileNotFoundError:
            pass
        self._clean_partials()
        self._fsync_directory()


class DockerServices:
    def __init__(self, runner, target):
        self.runner = runner
        self.target = target
        self.ready_timeout = configured_timeout(
            "DOJO_RESTORE_READY_TIMEOUT_SECONDS", DEFAULT_READY_TIMEOUT
        )
        self.cold_start_timeout = configured_timeout(
            "DOJO_RESTORE_COLD_START_TIMEOUT_SECONDS", DEFAULT_COLD_START_TIMEOUT
        )
        self.http_timeout = self.ready_timeout

    def inspect(self, service, *, deadline=None):
        timeout = (
            self.ready_timeout
            if deadline is None
            else remaining_before_deadline(
                deadline,
                f"timed out while inspecting {service}",
            )
        )
        result = self.runner.run(
            ["docker", "inspect", "--type=container", service],
            capture_output=True,
            check=False,
            timeout=timeout,
        )
        if result.returncode:
            return None
        try:
            container = json.loads(result.stdout)[0]
            state = container["State"]
        except (json.JSONDecodeError, KeyError, IndexError) as error:
            raise RestoreError(f"could not inspect {service}") from error
        return {
            "id": container["Id"],
            "running": bool(state["Running"]),
            "status": state["Status"],
            "paused": bool(state.get("Paused")),
            "restarting": bool(state.get("Restarting")),
            "started_at": state.get("StartedAt", ""),
            "health": state.get("Health", {}).get("Status"),
            "restart_policy": container["HostConfig"]["RestartPolicy"]["Name"],
            "restart_retries": container["HostConfig"]["RestartPolicy"][
                "MaximumRetryCount"
            ],
        }

    def database_client_available(self):
        database = self.inspect("db")
        return (
            database is not None
            and database["running"]
            and not database["paused"]
            and not database["restarting"]
        )

    def snapshot_database_for_startup(self):
        database = self.inspect("db")
        if database is None:
            return {"present": False, "running": False, "id": None}
        if database["paused"] or database["restarting"] or database["status"] not in {
            "running",
            "exited",
            "created",
        }:
            raise RestoreError("database container is not stable for startup recovery")
        return {
            "present": True,
            "running": database["running"],
            "id": database["id"],
        }

    def verify_startup_database_identity(self, expected):
        database = self.inspect("db")
        if expected["present"] and (
            database is None or database["id"] != expected["id"]
        ):
            raise RestoreError("database container changed during startup recovery")

    def bind_startup_database_identity(self, expected):
        database = self.snapshot_database_for_startup()
        if not database["present"] or not database["running"]:
            raise RestoreError("database container failed during startup recovery")
        if expected["present"] and database["id"] != expected["id"]:
            raise RestoreError("database container changed during startup recovery")
        return database

    def ensure_database_client(self):
        deadline = time.monotonic() + self.ready_timeout
        timeout_error = (
            "database client container did not become ready within "
            f"{self.ready_timeout} seconds"
        )
        state = self.inspect("db", deadline=deadline)
        if state is None:
            raise RestoreError("required database client container is missing: db")
        if not state["running"]:
            self.runner.run(
                ["docker", "start", "db"],
                timeout=remaining_before_deadline(deadline, timeout_error),
            )
        while True:
            remaining_before_deadline(deadline, timeout_error)
            state = self.inspect("db", deadline=deadline)
            if state is None or state["status"] in ("dead", "removing"):
                raise RestoreError("database client container failed during startup")
            if state["running"] and not state["paused"] and not state["restarting"]:
                return
            wait_for_retry(deadline, timeout_error)

    def _snapshot_service(self, service, state, *, allow_unready):
        if state is None:
            raise RestoreError(f"required container is missing: {service}")
        if state["paused"] or state["restarting"]:
            raise RestoreError(f"{service} is not in a stable state")
        if state["status"] not in ("running", "exited", "created"):
            raise RestoreError(f"{service} is in unsupported state {state['status']}")
        if (
            not allow_unready
            and state["running"]
            and state["health"] not in (None, "healthy")
        ):
            raise RestoreError(f"{service} is not healthy before restore")
        if (
            not allow_unready
            and service
            in (
                "cache",
                "pgbouncer",
                "stats-worker",
                "ctfd",
                "nginx",
            )
            and state["status"] == "created"
        ):
            raise RestoreError(f"{service} must be started once before restore")
        return {
            "id": state["id"],
            "restart_policy": state["restart_policy"],
            "restart_retries": state["restart_retries"],
            "running": state["running"],
            "status": state["status"],
        }

    def snapshot_service(self, service):
        return self._snapshot_service(
            service,
            self.inspect(service),
            allow_unready=False,
        )

    def snapshot(self):
        snapshot = {
            service: self.snapshot_service(service) for service in SNAPSHOT_SERVICES
        }
        if any(snapshot[name]["running"] for name in DATABASE_CLIENTS) and not snapshot[
            "pgbouncer"
        ]["running"]:
            raise RestoreError("running database clients require a running pgbouncer")
        if any(snapshot[name]["running"] for name in DATABASE_CLIENTS) and not snapshot[
            "cache"
        ]["running"]:
            raise RestoreError("running database clients require a running cache")
        return snapshot

    def snapshot_for_startup(self):
        states = {service: self.inspect(service) for service in SNAPSHOT_SERVICES}
        if all(state is None for state in states.values()):
            return None
        missing = [service for service, state in states.items() if state is None]
        if missing:
            return None
        return {
            service: self._snapshot_service(
                service,
                state,
                allow_unready=True,
            )
            for service, state in states.items()
        }

    def verify_identities(self, snapshot):
        for service, expected in snapshot.items():
            state = self.inspect(service)
            if state is None or state["id"] != expected["id"]:
                raise RestoreError(f"container changed during restore: {service}")

    def require_supported_snapshot(self, snapshot):
        if not isinstance(snapshot, dict) or frozenset(snapshot) != frozenset(
            SNAPSHOT_SERVICES
        ):
            raise RestoreError("restore journal has an unsupported service snapshot")

    def stop(self, service):
        state = self.inspect(service)
        if state is None:
            raise RestoreError(f"container disappeared during restore: {service}")
        if state["running"] or state["paused"] or state["restarting"]:
            self.runner.run(
                ["docker", "stop", service],
                timeout=self.ready_timeout,
            )
        state = self.inspect(service)
        if state is None or state["running"] or state["paused"] or state["restarting"]:
            raise RestoreError(f"failed to stop {service}")

    def start(self, service):
        state = self.inspect(service)
        if state is None:
            raise RestoreError(f"container disappeared during restore: {service}")
        if not state["running"]:
            self.runner.run(
                ["docker", "start", service],
                timeout=self.ready_timeout,
            )

    def stop_clients(self, snapshot):
        self.require_supported_snapshot(snapshot)
        self.verify_identities(snapshot)
        for service in STOP_ORDER:
            self.stop(service)
        self.verify_clients_stopped()

    def verify_clients_stopped(self):
        running = [
            service
            for service in (*DATABASE_CLIENTS, "nginx")
            if (self.inspect(service) or {}).get("running")
        ]
        if running:
            raise RestoreError(
                f"database clients or ingress remained running: {', '.join(running)}"
            )

    def gate_restarts(self, snapshot):
        self.require_supported_snapshot(snapshot)
        self.verify_identities(snapshot)
        self.runner.run(
            ["docker", "update", "--restart=no", *snapshot],
            timeout=self.ready_timeout,
        )
        for service in snapshot:
            state = self.inspect(service)
            if state["restart_policy"] != "no" or state["restart_retries"] != 0:
                raise RestoreError(f"failed to maintenance-gate {service}")

    def restore_restart_policies(self, snapshot):
        for service, expected in snapshot.items():
            policy = expected["restart_policy"] or "no"
            if policy == "on-failure" and expected["restart_retries"]:
                policy = f"{policy}:{expected['restart_retries']}"
            self.runner.run(
                ["docker", "update", f"--restart={policy}", service],
                timeout=self.ready_timeout,
            )
        for service, expected in snapshot.items():
            state = self.inspect(service)
            if (
                state["restart_policy"] != expected["restart_policy"]
                or state["restart_retries"] != expected["restart_retries"]
            ):
                raise RestoreError(f"failed to restore restart policy for {service}")

    def wait_cache(self):
        deadline = time.monotonic() + self.ready_timeout
        timeout_error = (
            f"cache did not answer PING within {self.ready_timeout} seconds"
        )
        while True:
            remaining_before_deadline(deadline, timeout_error)
            state = self.inspect("cache", deadline=deadline)
            if state is None or state["status"] in ("exited", "dead", "removing"):
                raise RestoreError("cache failed while preparing restored state")
            if state["running"]:
                ping = self.runner.run(
                    ["docker", "exec", "cache", "redis-cli", "PING"],
                    capture_output=True,
                    check=False,
                    timeout=remaining_before_deadline(deadline, timeout_error),
                )
                if ping.returncode == 0 and ping.stdout.strip() == b"PONG":
                    return
            wait_for_retry(deadline, timeout_error)

    def wait_pgbouncer(self):
        deadline = time.monotonic() + self.ready_timeout
        timeout_error = (
            "pgbouncer did not accept connections within "
            f"{self.ready_timeout} seconds"
        )
        while True:
            remaining_before_deadline(deadline, timeout_error)
            state = self.inspect("pgbouncer", deadline=deadline)
            if state is None or state["status"] in ("exited", "dead", "removing"):
                raise RestoreError("pgbouncer failed while preparing restored state")
            ready = self.runner.run(
                [
                    "docker",
                    "exec",
                    "db",
                    "timeout",
                    "--signal=KILL",
                    f"{max(1, int(remaining_before_deadline(deadline, timeout_error)))}s",
                    "pg_isready",
                    "--host=pgbouncer",
                    "--port=5432",
                    f"--dbname={self.target.name}",
                    f"--username={self.target.user}",
                ],
                capture_output=True,
                check=False,
                timeout=remaining_before_deadline(deadline, timeout_error),
            )
            if ready.returncode == 0:
                return
            wait_for_retry(deadline, timeout_error)

    def direct_database_url(self):
        return self.target.database_url()

    def cleanup_private_validation(self):
        result = self.runner.run(
            [
                "docker",
                "inspect",
                "--type=container",
                PRIVATE_VALIDATION_CONTAINER,
            ],
            capture_output=True,
            check=False,
            timeout=self.ready_timeout,
        )
        if result.returncode:
            return
        try:
            container = json.loads(result.stdout)[0]
            labels = container["Config"].get("Labels") or {}
        except (json.JSONDecodeError, KeyError, IndexError) as error:
            raise RestoreError("could not inspect the private validation container") from error
        if not isinstance(labels, dict):
            raise RestoreError("could not inspect the private validation container")
        if labels.get(PRIVATE_VALIDATION_LABEL) != "1":
            raise RestoreError(
                f"reserved validation container name is occupied: {PRIVATE_VALIDATION_CONTAINER}"
            )
        removal = self.runner.run(
            ["docker", "rm", "--force", PRIVATE_VALIDATION_CONTAINER],
            capture_output=True,
            check=False,
            timeout=self.ready_timeout,
        )
        if removal.returncode:
            remaining = self.runner.run(
                [
                    "docker",
                    "inspect",
                    "--type=container",
                    PRIVATE_VALIDATION_CONTAINER,
                ],
                stdout=subprocess.DEVNULL,
                check=False,
                timeout=self.ready_timeout,
            )
            if remaining.returncode == 0:
                raise RestoreError("could not remove the private validation container")

    def run_private_validation(self, name, program, timeout):
        self.verify_clients_stopped()
        self.cleanup_private_validation()
        database_url = self.direct_database_url()
        arguments = [
            "dojo",
            "compose",
            "run",
            "--rm",
            "--no-deps",
            "-T",
            "--name",
            PRIVATE_VALIDATION_CONTAINER,
            "--label",
            f"{PRIVATE_VALIDATION_LABEL}=1",
            "--env",
            "DATABASE_URL",
        ]
        if CACHE_VALIDATION_TEST_ENVIRONMENT in os.environ:
            arguments.extend(("--env", CACHE_VALIDATION_TEST_ENVIRONMENT))
        arguments.extend(("ctfd", "python", "-c", program))
        try:
            result = self.runner.run(
                arguments,
                capture_output=True,
                timeout=timeout,
                environment={**os.environ, "DATABASE_URL": database_url},
            )
        except RestoreError as error:
            raise RestoreError(f"private {name} validation failed: {error}") from error
        finally:
            self.cleanup_private_validation()
        self.verify_clients_stopped()
        return result

    def warm_cache(self):
        self.start("cache")
        self.wait_cache()
        flush = self.runner.run(
            ["docker", "exec", "cache", "redis-cli", "FLUSHDB"],
            capture_output=True,
            timeout=self.ready_timeout,
        )
        if flush.stdout.strip() != b"OK":
            raise RestoreError("cache rejected FLUSHDB before restored-state warmup")
        validation = self.run_private_validation(
            "cache",
            CACHE_VALIDATION_PROGRAM,
            self.cold_start_timeout,
        )
        if CACHE_VALIDATION_MARKER not in validation.stdout:
            raise RestoreError("cache warmup did not validate every required cache family")
        cache_check = self.runner.run(
            [
                "docker",
                "exec",
                "cache",
                "redis-cli",
                "EXISTS",
                "stats:belts",
                "stats:emojis",
                "stats:containers",
            ],
            capture_output=True,
            timeout=self.ready_timeout,
        )
        if cache_check.stdout.strip() != b"3":
            raise RestoreError("stats-worker cold start did not populate required cache keys")
        persistence = self.runner.run(
            ["docker", "exec", "cache", "redis-cli", "SAVE"],
            capture_output=True,
            timeout=self.cold_start_timeout,
        )
        if persistence.stdout.strip() != b"OK":
            raise RestoreError("cache did not durably persist the restored state")
        pause_for_test("cache-persisted")

    def wait_service(self, service):
        deadline = time.monotonic() + self.ready_timeout
        timeout_error = (
            f"{service} did not become ready within {self.ready_timeout} seconds"
        )
        while True:
            remaining_before_deadline(deadline, timeout_error)
            state = self.inspect(service, deadline=deadline)
            if state is None:
                raise RestoreError(f"{service} disappeared during startup")
            if (
                state["status"] in ("exited", "dead", "removing")
                or state["restarting"]
                or state["health"] == "unhealthy"
            ):
                raise RestoreError(f"{service} failed during startup")
            if state["running"] and state["health"] in (None, "healthy"):
                return
            wait_for_retry(deadline, timeout_error)

    def validate_application(self, *, fail_after_validation=False):
        program = APPLICATION_VALIDATION_PROGRAM
        if fail_after_validation:
            program += (
                "\nraise RuntimeError('injected application validation failure')\n"
            )
        self.run_private_validation(
            "application",
            program,
            self.ready_timeout,
        )

    def restore_snapshot(self, snapshot):
        self.require_supported_snapshot(snapshot)
        self.verify_identities(snapshot)
        for service in START_ORDER:
            if snapshot[service]["running"]:
                self.start(service)
                if service == "cache":
                    self.wait_cache()
                elif service == "pgbouncer":
                    self.wait_pgbouncer()
                elif service != "stats-worker":
                    self.wait_service(service)
        for service in (*STOP_ORDER, "cache"):
            if not snapshot[service]["running"]:
                self.stop(service)
        self.restore_restart_policies(snapshot)
        self.verify_identities(snapshot)
        for service, expected in snapshot.items():
            state = self.inspect(service)
            if (
                state["running"] != expected["running"]
                or state["status"] != expected["status"]
                or state["restart_policy"] != expected["restart_policy"]
                or state["restart_retries"] != expected["restart_retries"]
            ):
                raise RestoreError(f"failed to restore initial state for {service}")

    def wait_external_http(self):
        nginx = self.inspect("nginx")
        if nginx is None or not nginx["running"]:
            return
        host = os.environ.get("DOJO_HOST", "localhost.pwn.college")
        if not host or any(character in host for character in "\x00\r\n"):
            raise RestoreError("DOJO_HOST is invalid")
        production = os.environ.get("DOJO_ENV") == "production"
        port = 443 if production else 80
        deadline = time.monotonic() + self.http_timeout
        last_failure = "no response"
        while True:
            timeout_error = (
                "nginx did not serve the CTFd application within "
                f"{self.http_timeout} seconds: {last_failure}"
            )
            remaining = remaining_before_deadline(deadline, timeout_error)
            connection = None
            try:
                if production:
                    connection = LoopbackHTTPSConnection(
                        host,
                        port,
                        timeout=min(2, remaining),
                        context=ssl.create_default_context(),
                    )
                else:
                    connection = http.client.HTTPConnection(
                        "127.0.0.1", port, timeout=min(2, remaining)
                    )
                connection.request("GET", "/", headers={"Host": host})
                response = connection.getresponse()
                response_body = response.read()
                if (
                    response.status == 200
                    and APPLICATION_RESPONSE_MARKER in response_body
                ):
                    return
                last_failure = (
                    f"HTTP {response.status} without the expected CTFd response"
                )
            except (OSError, http.client.HTTPException) as error:
                last_failure = str(error)
            finally:
                if connection is not None:
                    connection.close()
            timeout_error = (
                "nginx did not serve the CTFd application within "
                f"{self.http_timeout} seconds: {last_failure}"
            )
            wait_for_retry(deadline, timeout_error)


class DatabaseRestore:
    def __init__(self, runner, state, services, target):
        self.runner = runner
        self.state = state
        self.services = services
        self.application_target = target
        self.target = target
        self.database_name = target.name
        self.drain_timeout = services.ready_timeout
        self.operation_timeout = getattr(
            services,
            "cold_start_timeout",
            self.drain_timeout,
        )
        self.installation_id = (
            getattr(state, "installation_id", None) or "0" * INSTALLATION_ID_LENGTH
        )
        validate_installation_id(self.installation_id)
        self.fenced_database_name = f"dojo_restore_{self.installation_id}"
        self.application_names = tuple(
            application_name(name, self.installation_id)
            for name in MAINTENANCE_APPLICATION_NAMES
        )
        maintenance_secret = getattr(state, "maintenance_secret", None)
        self.maintenance_secret = maintenance_secret
        maintenance_role = getattr(state, "maintenance_role", None)
        if maintenance_role and maintenance_role == target.user:
            raise RestoreError(
                "restore maintenance role must differ from the configured "
                "PostgreSQL application role"
            )
        self.maintenance_target = (
            target.with_credentials(maintenance_role, maintenance_secret)
            if maintenance_role and maintenance_secret
            else None
        )
        self.maintenance_provenance = (
            maintenance_role_provenance(self.installation_id, maintenance_secret)
            if self.maintenance_target is not None
            else None
        )

    def cluster_claims(self, server_identity):
        if self.maintenance_secret is None:
            raise RestoreError("restore cluster ownership identity is unavailable")
        resources = {
            "database": self.database_name,
            "role": self.application_target.user,
        }
        return {
            cluster_claim_role_name(kind, server_identity, resource): (
                cluster_claim_provenance(
                    self.installation_id,
                    self.maintenance_secret,
                    kind,
                    server_identity,
                    resource,
                )
            )
            for kind, resource in resources.items()
        }

    @property
    def restore_application_name(self):
        return application_name(RESTORE_APPLICATION_NAME, self.installation_id)

    @property
    def snapshot_application_name(self):
        return application_name(SNAPSHOT_APPLICATION_NAME, self.installation_id)

    def use_application_target(self):
        self.target = self.application_target
        self.services.target = self.application_target

    def use_maintenance_target(self):
        if self.maintenance_target is None:
            raise RestoreError("restore maintenance identity is unavailable")
        self.target = self.maintenance_target
        self.services.target = self.maintenance_target

    def use_fenced_maintenance_target(self):
        self.use_maintenance_target()
        self.target = self.maintenance_target.with_database(
            self.fenced_database_name
        )
        self.services.target = self.target

    def psql(self, sql, *, deadline=None, check=True, target=None):
        timeout = (
            self.drain_timeout
            if deadline is None
            else remaining_before_deadline(deadline, "database command timed out")
        )
        return (target or self.target).run_client(
            self.runner,
            "psql",
            (
                "--no-psqlrc",
                "--tuples-only",
                "--no-align",
                "--set=ON_ERROR_STOP=1",
                "--command",
                sql,
            ),
            database="postgres",
            connect=True,
            application_name=self.restore_application_name,
            capture_output=True,
            check=check,
            timeout=timeout,
        )

    def psql_private(self, sql, *, target):
        with tempfile.TemporaryFile() as input_file:
            input_file.write(sql.encode())
            input_file.seek(0)
            return target.run_client(
                self.runner,
                "psql",
                (
                    "--no-psqlrc",
                    "--tuples-only",
                    "--no-align",
                    "--set=ON_ERROR_STOP=1",
                ),
                database="postgres",
                connect=True,
                application_name=self.restore_application_name,
                input_stream=True,
                stdin=input_file,
                capture_output=True,
                timeout=self.drain_timeout,
            )

    def wait_ready(self):
        deadline = time.monotonic() + self.drain_timeout
        last_failure = "no PostgreSQL response"
        while True:
            timeout_error = (
                "configured PostgreSQL target did not become ready within "
                f"{self.drain_timeout} seconds: {last_failure}"
            )
            remaining_before_deadline(deadline, timeout_error)
            result = self.psql(
                "SELECT 1;",
                deadline=deadline,
                check=False,
            )
            if result.returncode == 0 and result.stdout.strip() == b"1":
                return
            last_failure = result.stderr.decode(errors="replace").strip()[-2000:]
            if not last_failure:
                last_failure = f"database client exited {result.returncode}"
            timeout_error = (
                "configured PostgreSQL target did not become ready within "
                f"{self.drain_timeout} seconds: {last_failure}"
            )
            wait_for_retry(deadline, timeout_error)

    def capture_maintenance_role(self, *, target=None):
        if self.maintenance_target is None:
            raise RestoreError("restore maintenance identity is unavailable")
        role_name = self.maintenance_target.user
        result = self.psql(
            "SELECT json_build_object("
            "'name', role.rolname, "
            "'oid', role.oid::bigint, "
            "'comment', shobj_description(role.oid, 'pg_authid'), "
            "'superuser', role.rolsuper, "
            "'inherit', role.rolinherit, "
            "'create_db', role.rolcreatedb, "
            "'create_role', role.rolcreaterole, "
            "'login', role.rolcanlogin, "
            "'replication', role.rolreplication, "
            "'bypass_rls', role.rolbypassrls, "
            "'connection_limit', role.rolconnlimit, "
            "'valid_until_null', role.rolvaliduntil IS NULL, "
            "'config_null', role.rolconfig IS NULL, "
            "'memberships', (SELECT count(*) FROM pg_auth_members AS membership "
            "WHERE membership.roleid = role.oid OR membership.member = role.oid "
            "OR membership.grantor = role.oid)"
            ") FROM pg_roles AS role "
            f"WHERE role.rolname = {sql_literal(role_name)};",
            target=target or self.application_target,
        ).stdout.strip()
        if not result:
            return None
        try:
            role = json.loads(result)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("maintenance role lookup returned invalid data") from error
        if not isinstance(role, dict) or set(role) != {
            "name",
            "oid",
            "comment",
            "superuser",
            "inherit",
            "create_db",
            "create_role",
            "login",
            "replication",
            "bypass_rls",
            "connection_limit",
            "valid_until_null",
            "config_null",
            "memberships",
        }:
            raise RestoreError("maintenance role lookup returned invalid data")
        return role

    def capture_cluster_claim(self, role_name):
        result = self.psql(
            "SELECT json_build_object("
            "'name', role.rolname, "
            "'comment', shobj_description(role.oid, 'pg_authid'), "
            "'superuser', role.rolsuper, "
            "'inherit', role.rolinherit, "
            "'create_db', role.rolcreatedb, "
            "'create_role', role.rolcreaterole, "
            "'login', role.rolcanlogin, "
            "'replication', role.rolreplication, "
            "'bypass_rls', role.rolbypassrls, "
            "'connection_limit', role.rolconnlimit, "
            "'valid_until_null', role.rolvaliduntil IS NULL, "
            "'config_null', role.rolconfig IS NULL, "
            "'memberships', (SELECT count(*) FROM pg_auth_members AS membership "
            "WHERE membership.roleid = role.oid OR membership.member = role.oid "
            "OR membership.grantor = role.oid)"
            ") FROM pg_roles AS role "
            f"WHERE role.rolname = {sql_literal(role_name)};"
        ).stdout.strip()
        if not result:
            return None
        try:
            claim = json.loads(result)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("database cluster claim lookup returned invalid data") from error
        return claim

    def verify_cluster_claim(self, claim, role_name, provenance):
        expected = {
            "name": role_name,
            "comment": provenance,
            "superuser": False,
            "inherit": True,
            "create_db": False,
            "create_role": False,
            "login": False,
            "replication": False,
            "bypass_rls": False,
            "connection_limit": -1,
            "valid_until_null": True,
            "config_null": True,
            "memberships": 0,
        }
        if not isinstance(claim, dict) or claim != expected:
            raise RestoreError(
                "PostgreSQL database or application role is claimed by another "
                "installation"
            )

    def acquire_cluster_claims(self, server_identity):
        claims = self.cluster_claims(server_identity)
        existing = {
            role_name: self.capture_cluster_claim(role_name)
            for role_name in claims
        }
        for role_name, claim in existing.items():
            if claim is not None:
                self.verify_cluster_claim(claim, role_name, claims[role_name])
        missing = [role_name for role_name, claim in existing.items() if claim is None]
        if missing:
            statements = ["BEGIN"]
            for role_name in missing:
                role = sql_identifier(role_name)
                statements.extend(
                    (
                        f"CREATE ROLE {role} WITH NOLOGIN NOSUPERUSER INHERIT "
                        "NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS "
                        "CONNECTION LIMIT -1 PASSWORD NULL",
                        f"COMMENT ON ROLE {role} IS {sql_literal(claims[role_name])}",
                    )
                )
            statements.append("COMMIT")
            self.psql_private(";".join(statements) + ";", target=self.target)
        for role_name, provenance in claims.items():
            self.verify_cluster_claim(
                self.capture_cluster_claim(role_name),
                role_name,
                provenance,
            )

    def verify_maintenance_role(self, role, *, login):
        if role is None:
            raise RestoreError("helper-owned PostgreSQL maintenance role is missing")
        if (
            not isinstance(role["comment"], str)
            or not hmac.compare_digest(role["comment"], self.maintenance_provenance)
        ):
            raise RestoreError(
                "existing PostgreSQL maintenance role is not owned by this installation"
            )
        expected = {
            "name": self.maintenance_target.user,
            "superuser": True,
            "inherit": True,
            "create_db": False,
            "create_role": False,
            "login": login,
            "replication": False,
            "bypass_rls": False,
            "connection_limit": -1,
            "valid_until_null": True,
            "config_null": True,
            "memberships": 0,
        }
        if (
            type(role["oid"]) is not int
            or role["oid"] <= 0
            or any(role[field] != value for field, value in expected.items())
        ):
            raise RestoreError(
                "helper-owned PostgreSQL maintenance role has unsafe attributes"
            )
        return role

    def verify_maintenance_role_reusable(self):
        role = self.capture_maintenance_role(target=self.application_target)
        if role is not None:
            self.verify_maintenance_role(role, login=False)
        return role

    def verify_maintenance_role_deactivatable(self):
        role = self.capture_maintenance_role(target=self.application_target)
        if role is not None:
            self.verify_maintenance_role(role, login=role["login"])
        return role

    def activate_maintenance_role(self):
        if self.maintenance_target is None:
            raise RestoreError("restore maintenance identity is unavailable")
        self.use_application_target()
        role = sql_identifier(self.maintenance_target.user)
        existing = self.verify_maintenance_role_reusable()
        password_verifier = sql_literal(
            scram_verifier(self.maintenance_target.password)
        )
        if existing is None:
            statement = (
                "BEGIN;"
                f"CREATE ROLE {role} WITH LOGIN SUPERUSER INHERIT NOCREATEDB "
                "NOCREATEROLE NOREPLICATION NOBYPASSRLS CONNECTION LIMIT -1 "
                f"PASSWORD {password_verifier};"
                f"COMMENT ON ROLE {role} IS "
                f"{sql_literal(self.maintenance_provenance)};"
                "COMMIT;"
            )
        else:
            statement = (
                "BEGIN;"
                f"ALTER ROLE {role} WITH LOGIN SUPERUSER INHERIT NOCREATEDB "
                "NOCREATEROLE NOREPLICATION NOBYPASSRLS CONNECTION LIMIT -1 "
                f"PASSWORD {password_verifier};"
                "COMMIT;"
            )
        self.psql_private(statement, target=self.application_target)
        self.verify_maintenance_role(
            self.capture_maintenance_role(target=self.application_target),
            login=True,
        )
        pause_for_test("maintenance-role-activated")
        self.use_maintenance_target()
        self.wait_ready()

    def deactivate_maintenance_role(self):
        if self.maintenance_target is None:
            return
        role = sql_identifier(self.maintenance_target.user)
        self.use_application_target()
        existing = self.verify_maintenance_role_deactivatable()
        if existing is None:
            return
        if existing["login"]:
            self.psql(f"ALTER ROLE {role} NOLOGIN;", target=self.application_target)
        self.verify_maintenance_role(
            self.capture_maintenance_role(target=self.application_target),
            login=False,
        )
        pause_for_test("maintenance-role-deactivated")

    def establish_fence(self, metadata, application_role, *, preflight=False):
        validate_database_metadata(metadata)
        validate_application_role(application_role)
        if application_role["name"] != self.application_target.user:
            raise RestoreError("database fence application role is inconsistent")
        self.use_maintenance_target()
        database = sql_identifier(self.database_name)
        fenced_database = sql_identifier(self.fenced_database_name)
        database_oid = self.capture_database_oid(self.database_name)
        fenced_database_oid = self.capture_database_oid(self.fenced_database_name)
        if database_oid == metadata["oid"] and fenced_database_oid is None:
            self.psql(f"ALTER DATABASE {database} ALLOW_CONNECTIONS false;")
            pause_for_test("fence-denied")
            self.drain_database(metadata["oid"])
            pause_for_test("fence-drained")
            if preflight:
                self.preflight_recreation(self.database_name)
            self.disable_application_role(application_role)
            if preflight:
                self.preflight_recreation(self.database_name)
            maintenance_role = sql_identifier(self.maintenance_target.user)
            self.psql(
                "BEGIN;"
                f"ALTER DATABASE {database} OWNER TO {maintenance_role};"
                f"ALTER DATABASE {database} IS_TEMPLATE false;"
                f"ALTER DATABASE {database} RENAME TO {fenced_database};"
                "COMMIT;"
            )
            pause_for_test("fence-renamed")
            fenced_database_oid = metadata["oid"]
        elif database_oid is not None or fenced_database_oid not in {
            None,
            metadata["oid"],
        }:
            raise RestoreError("database fence identity is inconsistent")
        self.use_fenced_maintenance_target()
        if fenced_database_oid is not None:
            if database_oid is None:
                self.psql(
                    f"ALTER DATABASE {fenced_database} ALLOW_CONNECTIONS false;"
                )
                self.drain_database(metadata["oid"])
                self.disable_application_role(application_role)
            application_role_identifier = sql_identifier(self.application_target.user)
            maintenance_role = sql_identifier(self.maintenance_target.user)
            self.psql(
                f"ALTER DATABASE {fenced_database} OWNER TO {maintenance_role};"
                f"ALTER DATABASE {fenced_database} IS_TEMPLATE false;"
                f"ALTER DATABASE {fenced_database} CONNECTION LIMIT 0;"
                f"REVOKE CONNECT ON DATABASE {fenced_database} "
                f"FROM PUBLIC, {application_role_identifier};"
                f"ALTER DATABASE {fenced_database} ALLOW_CONNECTIONS true;"
            )
            self.verify_fence_integrity()
            pause_for_test("fence-enabled")
        else:
            self.disable_application_role(application_role)

    def release_fence(self, metadata, application_role):
        validate_database_metadata(metadata)
        validate_application_role(application_role)
        if application_role["name"] != self.application_target.user:
            raise RestoreError("database fence application role is inconsistent")
        self.use_maintenance_target()
        database = sql_identifier(self.database_name)
        fenced_database = sql_identifier(self.fenced_database_name)
        database_oid = self.capture_database_oid(self.database_name)
        fenced_database_oid = self.capture_database_oid(self.fenced_database_name)
        if fenced_database_oid == metadata["oid"] and database_oid is None:
            self.use_fenced_maintenance_target()
            self.psql(
                f"ALTER DATABASE {fenced_database} ALLOW_CONNECTIONS false;"
            )
            self.drain_database(metadata["oid"])
            pause_for_test("release-drained")
            self.psql(
                f"ALTER DATABASE {fenced_database} OWNER TO "
                f"{sql_identifier(metadata['owner'])};"
            )
            self.restore_database_acl(metadata)
            self.psql(
                f"ALTER DATABASE {fenced_database} CONNECTION LIMIT "
                f"{metadata['connection_limit']};"
                f"ALTER DATABASE {fenced_database} IS_TEMPLATE false;"
                f"ALTER DATABASE {fenced_database} ALLOW_CONNECTIONS "
                f"{'true' if metadata['allow_connections'] else 'false'};"
                f"ALTER DATABASE {fenced_database} RENAME TO {database};"
            )
            pause_for_test("release-renamed")
        elif database_oid == metadata["oid"] and fenced_database_oid is None:
            self.psql(
                f"ALTER DATABASE {database} OWNER TO "
                f"{sql_identifier(metadata['owner'])};"
            )
            self.restore_database_acl(metadata)
            self.psql(
                f"ALTER DATABASE {database} CONNECTION LIMIT "
                f"{metadata['connection_limit']};"
                f"ALTER DATABASE {database} IS_TEMPLATE false;"
                f"ALTER DATABASE {database} ALLOW_CONNECTIONS "
                f"{'true' if metadata['allow_connections'] else 'false'};"
            )
        else:
            raise RestoreError("database fence identity is inconsistent")
        self.restore_application_role(application_role)
        self.use_application_target()

    def enforce_fenced_acl(self):
        database = sql_identifier(self.target.name)
        application_role = sql_identifier(self.application_target.user)
        self.psql(
            f"REVOKE CONNECT ON DATABASE {database} "
            f"FROM PUBLIC, {application_role};"
        )
        self.verify_fence_integrity()

    def verify_fence_integrity(self):
        if self.maintenance_target is None:
            raise RestoreError("restore maintenance identity is unavailable")
        database = sql_literal(self.target.name)
        application_role = sql_literal(self.application_target.user)
        maintenance_role = sql_literal(self.maintenance_target.user)
        result = self.psql(
            "SELECT json_build_object("
            "'owner', (SELECT pg_get_userbyid(datdba) FROM pg_database "
            f"WHERE datname = {database}), "
            "'is_template', (SELECT datistemplate FROM pg_database "
            f"WHERE datname = {database}), "
            "'allow_connections', (SELECT datallowconn FROM pg_database "
            f"WHERE datname = {database}), "
            "'connection_limit', (SELECT datconnlimit FROM pg_database "
            f"WHERE datname = {database}), "
            "'application_superuser', (SELECT rolsuper FROM pg_roles "
            f"WHERE rolname = {application_role}), "
            "'application_login', (SELECT rolcanlogin FROM pg_roles "
            f"WHERE rolname = {application_role}), "
            "'application_sessions', (SELECT count(*) FROM pg_stat_activity "
            f"WHERE usename = {application_role} AND pid <> pg_backend_pid()), "
            "'unexpected_privileged_roles', (SELECT count(*) FROM pg_roles "
            "WHERE (rolsuper OR rolcreatedb) "
            f"AND rolname NOT IN ({application_role}, {maintenance_role}))"
            ");"
        )
        try:
            fence = json.loads(result.stdout)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("could not verify the PostgreSQL database fence") from error
        if fence != {
            "owner": self.maintenance_target.user,
            "is_template": False,
            "allow_connections": True,
            "connection_limit": 0,
            "application_superuser": True,
            "application_login": False,
            "application_sessions": 0,
            "unexpected_privileged_roles": 0,
        }:
            raise RestoreError("PostgreSQL database fence integrity was lost")

    def database_acl_statements(self, metadata, database):
        if metadata["acl_default"]:
            return []
        roles = {metadata["owner"]}
        roles.update(entry["grantor"] for entry in metadata["acl"])
        roles.update(
            entry["grantee"]
            for entry in metadata["acl"]
            if entry["grantee"] is not None
        )
        statements = [
            "BEGIN",
            f"REVOKE ALL ON DATABASE {database} FROM PUBLIC CASCADE",
        ]
        statements.extend(
            f"REVOKE ALL ON DATABASE {database} FROM {sql_identifier(role)} CASCADE"
            for role in sorted(roles)
        )
        available_grants = {
            (metadata["owner"], privilege)
            for privilege in ("CONNECT", "CREATE", "TEMPORARY")
        }
        pending_grants = list(metadata["acl"])
        while pending_grants:
            replayable = [
                entry
                for entry in pending_grants
                if (entry["grantor"], entry["privilege"]) in available_grants
            ]
            if not replayable:
                raise RestoreError("database ACL grant chain cannot be restored")
            for entry in replayable:
                pending_grants.remove(entry)
                grantee = (
                    "PUBLIC"
                    if entry["grantee"] is None
                    else sql_identifier(entry["grantee"])
                )
                grant_option = " WITH GRANT OPTION" if entry["grantable"] else ""
                statements.extend(
                    (
                        f"SET ROLE {sql_identifier(entry['grantor'])}",
                        f"GRANT {entry['privilege']} ON DATABASE {database} "
                        f"TO {grantee}{grant_option} GRANTED BY CURRENT_USER",
                        "RESET ROLE",
                    )
                )
                if entry["grantable"] and entry["grantee"] is not None:
                    available_grants.add((entry["grantee"], entry["privilege"]))
        statements.append("COMMIT")
        return statements

    def restore_database_acl(self, metadata):
        database = sql_identifier(self.target.name)
        if metadata["acl_default"]:
            self.psql(
                "UPDATE pg_database SET datacl = NULL "
                f"WHERE datname = {sql_literal(self.target.name)};"
            )
            return
        statements = self.database_acl_statements(metadata, database)
        self.psql(";".join(statements) + ";")

    def capture_server_identity(self):
        result = self.psql(
            "SELECT json_build_object("
            "'system_identifier', control.system_identifier::text, "
            "'server_version_num', current_setting('server_version_num')::integer"
            ") FROM pg_control_system() AS control;"
        )
        try:
            identity = json.loads(result.stdout)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("could not identify the configured PostgreSQL server") from error
        validate_server_identity(identity)
        return identity

    def capture_target(self):
        return self.application_target.journal_target(self.capture_server_identity())

    def verify_target(self, journal_target):
        self.verify_configured_target(journal_target)
        current_identity = self.capture_server_identity()
        if (
            current_identity["system_identifier"]
            != journal_target["server"]["system_identifier"]
            or current_identity["server_version_num"] // 10_000
            != journal_target["server"]["server_version_num"] // 10_000
        ):
            raise RestoreError(
                "PostgreSQL server identity does not match the pending restore journal"
            )
        self.acquire_cluster_claims(journal_target["server"])

    def verify_configured_target(self, journal_target):
        if not self.application_target.matches(journal_target):
            raise RestoreError(
                "configured database target does not match the pending restore journal"
            )

    def verify_configured_startup_target(self, journal_target):
        validate_database_configuration(journal_target)
        if self.application_target.configuration() != journal_target:
            raise RestoreError(
                "configured database target does not match the pending startup journal"
            )

    def capture_database_oid(self, database_name=None):
        database = sql_literal(database_name or self.database_name)
        result = self.psql(
            "SELECT json_build_object('oid', ("
            "SELECT oid::bigint FROM pg_database "
            f"WHERE datname = {database}));"
        )
        try:
            identity = json.loads(result.stdout)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("could not identify the configured database") from error
        if (
            not isinstance(identity, dict)
            or set(identity) != {"oid"}
            or (
                identity["oid"] is not None
                and (
                    type(identity["oid"]) is not int
                    or not 16_384 <= identity["oid"] <= 0xFFFFFFFF
                )
            )
        ):
            raise RestoreError("configured database identity query returned invalid data")
        return identity["oid"]

    def verify_database_identity(self, journal):
        expected_oid = journal["database"]["oid"]
        current_oid = self.capture_database_oid(self.database_name)
        fenced_oid = self.capture_database_oid(self.fenced_database_name)
        present_oids = [oid for oid in (current_oid, fenced_oid) if oid is not None]
        if not present_oids:
            if journal["phase"] not in {"restoring", "rolling_back"}:
                raise RestoreError(
                    "configured database is unexpectedly missing for the pending restore"
                )
            return
        if present_oids != [expected_oid]:
            raise RestoreError(
                "configured database identity does not match the pending restore journal"
            )

    def verify_journal_identity(self, journal):
        self.verify_target(journal["target"])
        self.verify_database_identity(journal)

    def verify_recreation_privileges(self):
        result = self.psql(
            "SELECT json_build_object('superuser', role.rolsuper) "
            "FROM pg_roles AS role WHERE role.rolname = current_user;"
        )
        try:
            privileges = json.loads(result.stdout)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError(
                "could not verify the PostgreSQL maintenance role"
            ) from error
        if privileges != {"superuser": True}:
            raise RestoreError(
                "database restore requires the configured PostgreSQL maintenance "
                "role to be a superuser"
            )

    def capture_application_role(self, *, target=None):
        role_name = self.application_target.user
        role = sql_literal(role_name)
        result = self.psql(
            "SELECT json_build_object('name', role.rolname, "
            "'superuser', role.rolsuper, 'login', role.rolcanlogin) "
            "FROM pg_roles AS role "
            f"WHERE role.rolname = {role};",
            target=target,
        )
        try:
            privileges = json.loads(result.stdout)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("could not verify the PostgreSQL application role") from error
        if (
            not isinstance(privileges, dict)
            or set(privileges) != {"name", "superuser", "login"}
            or privileges["name"] != role_name
            or privileges["superuser"] is not True
            or not isinstance(privileges["login"], bool)
        ):
            raise RestoreError(
                "database restore requires the configured PostgreSQL application "
                "role to be a superuser"
            )
        return {"name": role_name, "login": privileges["login"]}

    def verify_application_role(self):
        application_role = self.capture_application_role(
            target=self.application_target
        )
        if not application_role["login"]:
            raise RestoreError(
                "database restore requires the configured PostgreSQL application "
                "role to be a login superuser"
            )
        return application_role

    def disable_application_role(self, application_role):
        validate_application_role(application_role)
        current_role = self.capture_application_role()
        if current_role["name"] != application_role["name"]:
            raise RestoreError("database fence application role is inconsistent")
        role = sql_identifier(application_role["name"])
        role_name = sql_literal(application_role["name"])
        self.psql(
            f"ALTER ROLE {role} NOLOGIN;"
            "SELECT pg_terminate_backend(pid) FROM pg_stat_activity "
            f"WHERE usename = {role_name} AND pid <> pg_backend_pid();"
        )
        if self.capture_application_role()["login"]:
            raise RestoreError("database fence could not disable the application role")
        result = self.psql(
            "SELECT count(*) FROM pg_stat_activity "
            f"WHERE usename = {role_name} AND pid <> pg_backend_pid();"
        )
        try:
            remaining_sessions = int(result.stdout.strip())
        except (TypeError, ValueError) as error:
            raise RestoreError(
                "database fence application session check returned invalid data"
            ) from error
        if remaining_sessions:
            raise RestoreError(
                "database fence could not terminate every application role session"
            )
        pause_for_test("application-role-disabled")

    def restore_application_role(self, application_role):
        validate_application_role(application_role)
        current_role = self.capture_application_role()
        if current_role["name"] != application_role["name"]:
            raise RestoreError("database fence application role is inconsistent")
        role = sql_identifier(application_role["name"])
        login = "LOGIN" if application_role["login"] else "NOLOGIN"
        self.psql(f"ALTER ROLE {role} {login};")
        if self.capture_application_role()["login"] != application_role["login"]:
            raise RestoreError("database fence could not restore the application role")
        pause_for_test(
            "application-role-enabled"
            if application_role["login"]
            else "application-role-restored"
        )

    def verify_fence_available(self):
        if self.capture_database_oid(self.fenced_database_name) is not None:
            raise RestoreError(
                "database restore maintenance name is already in use on the "
                "configured PostgreSQL server"
            )

    def terminate_maintenance_backends(self):
        applications = ", ".join(
            sql_literal(application) for application in self.application_names
        )
        predicates = [
            f"(usename = {sql_literal(self.application_target.user)} "
            f"AND application_name IN ({applications}))"
        ]
        if self.maintenance_target is not None:
            predicates.append(
                f"usename = {sql_literal(self.maintenance_target.user)}"
            )
        predicate = " OR ".join(predicates)
        deadline = time.monotonic() + self.drain_timeout
        timeout_error = (
            "database maintenance sessions could not be terminated within "
            f"{self.drain_timeout} seconds"
        )
        while True:
            remaining_before_deadline(deadline, timeout_error)
            result = self.psql(
                "SELECT pg_terminate_backend(pid) FROM pg_stat_activity "
                f"WHERE ({predicate}) "
                "AND pid <> pg_backend_pid(); "
                "SELECT count(*) FROM pg_stat_activity "
                f"WHERE ({predicate}) "
                "AND pid <> pg_backend_pid();",
                deadline=deadline,
            )
            lines = [
                line.strip()
                for line in result.stdout.decode().splitlines()
                if line.strip()
            ]
            if lines and lines[-1] == "0":
                return
            wait_for_retry(deadline, timeout_error)

    def verify_exclusive_cluster_topology(self, database_name=None):
        database_name = database_name or self.database_name
        database = sql_literal(database_name)
        application_role = sql_literal(self.application_target.user)
        maintenance_role = (
            sql_literal(self.maintenance_target.user)
            if self.maintenance_target is not None
            else "NULL"
        )
        result = self.psql(
            "SELECT json_build_object("
            "'owner', (SELECT pg_get_userbyid(datdba) FROM pg_database "
            f"WHERE datname = {database}), "
            "'other_owned_databases', (SELECT count(*) FROM pg_database "
            f"WHERE datdba = (SELECT oid FROM pg_roles WHERE rolname = {application_role}) "
            f"AND datname <> {database} "
            "AND datname NOT IN ('postgres', 'template0', 'template1')), "
            "'privileged_roles', COALESCE((SELECT json_agg(rolname ORDER BY rolname) "
            "FROM pg_roles WHERE (rolsuper OR rolcreatedb) "
            f"AND rolname <> {application_role} "
            f"AND rolname <> {maintenance_role}), '[]'::json), "
            "'application_memberships', (SELECT count(*) FROM pg_auth_members "
            f"WHERE roleid = (SELECT oid FROM pg_roles WHERE rolname = {application_role}) "
            f"OR member = (SELECT oid FROM pg_roles WHERE rolname = {application_role})), "
            "'other_application_sessions', (SELECT count(*) FROM pg_stat_activity "
            f"WHERE usename = {application_role} AND pid <> pg_backend_pid() "
            f"AND datname IS DISTINCT FROM {database})"
            ");"
        )
        try:
            topology = json.loads(result.stdout)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("could not verify PostgreSQL cluster isolation") from error
        if not isinstance(topology, dict) or set(topology) != {
            "owner",
            "other_owned_databases",
            "privileged_roles",
            "application_memberships",
            "other_application_sessions",
        }:
            raise RestoreError("PostgreSQL cluster isolation check returned invalid data")
        if topology["owner"] != self.application_target.user:
            raise RestoreError(
                "configured PostgreSQL application role must exclusively own the "
                "restore database"
            )
        for field in (
            "other_owned_databases",
            "application_memberships",
            "other_application_sessions",
        ):
            if type(topology[field]) is not int or topology[field] < 0:
                raise RestoreError(
                    "PostgreSQL cluster isolation check returned invalid data"
                )
        if (
            not isinstance(topology["privileged_roles"], list)
            or any(
                not isinstance(role, str) or not role
                for role in topology["privileged_roles"]
            )
        ):
            raise RestoreError("PostgreSQL cluster isolation check returned invalid data")
        if topology["other_owned_databases"]:
            raise RestoreError(
                "configured PostgreSQL application role is shared by another database"
            )
        if topology["application_memberships"]:
            raise RestoreError(
                "configured PostgreSQL application role must not have role memberships"
            )
        if topology["other_application_sessions"]:
            raise RestoreError(
                "configured PostgreSQL application role has sessions in another database"
            )
        if topology["privileged_roles"]:
            raise RestoreError(
                "database restore requires an exclusive PostgreSQL cluster without "
                "additional superuser or CREATEDB roles"
            )

    def preflight_recreation(self, database_name=None):
        self.verify_recreation_privileges()
        self.verify_exclusive_cluster_topology(database_name)
        database = sql_literal(database_name or self.target.name)
        result = self.psql(
            "SELECT json_build_object("
            "'prepared_transactions', ("
            "SELECT count(*) FROM pg_prepared_xacts "
            f"WHERE database = {database}"
            "), "
            "'logical_slots', ("
            "SELECT count(*) FROM pg_replication_slots "
            f"WHERE database = {database}"
            "), "
            "'subscriptions', ("
            "SELECT count(*) FROM pg_subscription "
            "WHERE subdbid = (SELECT oid FROM pg_database "
            f"WHERE datname = {database})"
            "), "
            "'is_template', (SELECT datistemplate FROM pg_database "
            f"WHERE datname = {database})"
            ");"
        )
        try:
            blockers = json.loads(result.stdout)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("could not preflight database recreation") from error
        if not isinstance(blockers, dict) or set(blockers) != {
            "prepared_transactions",
            "logical_slots",
            "subscriptions",
            "is_template",
        } or any(
            type(blockers[field]) is not int or blockers[field] < 0
            for field in (
                "prepared_transactions",
                "logical_slots",
                "subscriptions",
            )
        ) or not isinstance(blockers["is_template"], bool):
            raise RestoreError("database recreation preflight returned invalid results")
        if blockers["is_template"]:
            raise RestoreError("template databases are unsupported for restore")
        present = [
            name.replace("_", " ")
            for name in (
                "prepared_transactions",
                "logical_slots",
                "subscriptions",
            )
            if blockers[name]
        ]
        if present:
            raise RestoreError(
                "database cannot be safely recreated while it has " + ", ".join(present)
            )

    def capture_metadata(self):
        database = sql_literal(self.target.name)
        result = self.psql(
            "SELECT json_build_object("
            "'oid', database.oid::bigint, "
            "'owner', pg_get_userbyid(database.datdba), "
            "'encoding', pg_encoding_to_char(database.encoding), "
            "'locale_provider', CASE database.datlocprovider "
            "WHEN 'b' THEN 'builtin' WHEN 'c' THEN 'libc' WHEN 'i' THEN 'icu' END, "
            "'collate', database.datcollate, "
            "'ctype', database.datctype, "
            "'locale', database.datlocale, "
            "'icu_rules', database.daticurules, "
            "'collation_version', database.datcollversion, "
            "'tablespace', tablespace.spcname, "
            "'allow_connections', database.datallowconn, "
            "'is_template', database.datistemplate, "
            "'connection_limit', database.datconnlimit, "
            "'acl_default', database.datacl IS NULL, "
            "'acl', COALESCE(("
            "SELECT json_agg(json_build_object("
            "'grantor', pg_get_userbyid(acl.grantor), "
            "'grantee', CASE WHEN acl.grantee = 0 THEN NULL "
            "ELSE pg_get_userbyid(acl.grantee) END, "
            "'privilege', acl.privilege_type, "
            "'grantable', acl.is_grantable"
            ") ORDER BY acl.grantor, acl.grantee, acl.privilege_type) "
            "FROM aclexplode(database.datacl) AS acl"
            "), '[]'::json), "
            "'comment', shobj_description(database.oid, 'pg_database'), "
            "'security_labels', COALESCE(("
            "SELECT json_agg(json_build_object("
            "'provider', label.provider, 'label', label.label"
            ") ORDER BY label.provider) "
            "FROM pg_shseclabel AS label "
            "WHERE label.classoid = 'pg_database'::regclass "
            "AND label.objoid = database.oid"
            "), '[]'::json), "
            "'settings', COALESCE(("
            "SELECT json_agg(json_build_object("
            "'role', CASE WHEN setting.setrole = 0 THEN NULL "
            "ELSE pg_get_userbyid(setting.setrole) END, "
            "'name', split_part(item.value, '=', 1), "
            "'value', substring(item.value FROM position('=' IN item.value) + 1)"
            ") ORDER BY setting.setrole, item.value) "
            "FROM pg_db_role_setting AS setting "
            "CROSS JOIN LATERAL unnest(setting.setconfig) AS item(value) "
            "WHERE setting.setdatabase = database.oid"
            "), '[]'::json)"
            ") "
            "FROM pg_database AS database "
            "JOIN pg_tablespace AS tablespace "
            "ON tablespace.oid = database.dattablespace "
            f"WHERE database.datname = {database};"
        )
        try:
            metadata = json.loads(result.stdout)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("could not capture database metadata") from error
        validate_database_metadata(metadata)
        if metadata["owner"] != self.application_target.user:
            raise RestoreError(
                "configured PostgreSQL application role must own the restore database"
            )
        return metadata

    def capture_backup_dependencies(self, required_role_names=()):
        if not isinstance(required_role_names, (list, tuple, set)):
            raise RestoreError("backup dependency role seed is invalid")
        required_role_names = sorted(set(required_role_names))
        for role_name in required_role_names:
            validate_text(role_name, "backup dependency role seed", limit=1024)
        required_role_seed = ""
        if required_role_names:
            roles = ", ".join(sql_literal(role) for role in required_role_names)
            required_role_seed = (
                " UNION SELECT oid FROM pg_roles WHERE rolname IN (" + roles + ")"
            )
        result = self.target.run_client(
            self.runner,
            "psql",
            (
                "--no-psqlrc",
                "--tuples-only",
                "--no-align",
                "--set=ON_ERROR_STOP=1",
                "--command",
                "WITH RECURSIVE target_database AS ("
                "SELECT oid, datdba FROM pg_database WHERE datname = current_database()"
                "), seed_roles AS ("
                "SELECT datdba AS oid FROM target_database UNION "
                "SELECT dependency.refobjid FROM pg_shdepend AS dependency "
                "JOIN target_database ON dependency.dbid = target_database.oid "
                "WHERE dependency.refclassid = 'pg_authid'::regclass UNION "
                "SELECT acl.grantor FROM pg_database AS database "
                "JOIN target_database ON target_database.oid = database.oid "
                "CROSS JOIN LATERAL aclexplode(database.datacl) AS acl UNION "
                "SELECT acl.grantee FROM pg_database AS database "
                "JOIN target_database ON target_database.oid = database.oid "
                "CROSS JOIN LATERAL aclexplode(database.datacl) AS acl "
                "WHERE acl.grantee <> 0 UNION "
                "SELECT setting.setrole FROM pg_db_role_setting AS setting "
                "JOIN target_database ON target_database.oid = setting.setdatabase "
                "WHERE setting.setrole <> 0 UNION "
                "SELECT defaclrole FROM pg_default_acl UNION "
                "SELECT acl.grantor FROM pg_default_acl AS defaults "
                "CROSS JOIN LATERAL aclexplode(defaults.defaclacl) AS acl UNION "
                "SELECT acl.grantee FROM pg_default_acl AS defaults "
                "CROSS JOIN LATERAL aclexplode(defaults.defaclacl) AS acl "
                "WHERE acl.grantee <> 0 UNION "
                "SELECT spcowner FROM pg_tablespace WHERE spcname NOT IN "
                "('pg_default', 'pg_global') UNION "
                "SELECT acl.grantor FROM pg_tablespace AS tablespace "
                "CROSS JOIN LATERAL aclexplode(tablespace.spcacl) AS acl "
                "WHERE tablespace.spcname NOT IN ('pg_default', 'pg_global') UNION "
                "SELECT acl.grantee FROM pg_tablespace AS tablespace "
                "CROSS JOIN LATERAL aclexplode(tablespace.spcacl) AS acl "
                "WHERE tablespace.spcname NOT IN ('pg_default', 'pg_global') "
                "AND acl.grantee <> 0"
                f"{required_role_seed}"
                "), role_graph(oid) AS ("
                "SELECT oid FROM seed_roles UNION "
                "SELECT related.oid "
                "FROM role_graph JOIN pg_auth_members AS membership "
                "ON membership.roleid = role_graph.oid "
                "OR membership.member = role_graph.oid "
                "OR membership.grantor = role_graph.oid "
                "CROSS JOIN LATERAL (VALUES (membership.roleid), "
                "(membership.member), (membership.grantor)) AS related(oid)"
                "), contract_roles AS ("
                "SELECT oid FROM role_graph UNION "
                "SELECT membership.grantor FROM pg_auth_members AS membership "
                "WHERE membership.roleid IN (SELECT oid FROM role_graph) "
                "AND membership.member IN (SELECT oid FROM role_graph)"
                ") SELECT json_build_object("
                "'roles', COALESCE((SELECT json_agg(json_build_object("
                "'name', role.rolname, 'superuser', role.rolsuper, "
                "'inherit', role.rolinherit, 'create_db', role.rolcreatedb, "
                "'create_role', role.rolcreaterole, 'login', role.rolcanlogin, "
                "'replication', role.rolreplication, 'bypass_rls', role.rolbypassrls, "
                "'connection_limit', role.rolconnlimit, "
                "'valid_until', role.rolvaliduntil::text, "
                "'config', COALESCE(role.rolconfig, ARRAY[]::text[])"
                ") ORDER BY role.rolname) FROM pg_roles AS role "
                "WHERE role.oid IN (SELECT oid FROM contract_roles) "
                "AND role.rolname !~ '^pg_'), '[]'::json), "
                "'memberships', COALESCE((SELECT json_agg(json_build_object("
                "'role', granted_role.rolname, 'member', member_role.rolname, "
                "'grantor', grantor_role.rolname, "
                "'admin_option', membership.admin_option, "
                "'inherit_option', membership.inherit_option, "
                "'set_option', membership.set_option"
                ") ORDER BY granted_role.rolname, member_role.rolname, grantor_role.rolname) "
                "FROM pg_auth_members AS membership "
                "JOIN pg_roles AS granted_role ON granted_role.oid = membership.roleid "
                "JOIN pg_roles AS member_role ON member_role.oid = membership.member "
                "JOIN pg_roles AS grantor_role ON grantor_role.oid = membership.grantor "
                "WHERE membership.roleid IN (SELECT oid FROM role_graph) "
                "AND membership.member IN (SELECT oid FROM role_graph)"
                "), '[]'::json), "
                "'default_acls', COALESCE((SELECT json_agg(json_build_object("
                "'owner', owner.rolname, 'schema', namespace.nspname, "
                "'object_type', defaults.defaclobjtype::text, "
                "'grantor', pg_get_userbyid(acl.grantor), "
                "'grantee', CASE WHEN acl.grantee = 0 THEN NULL "
                "ELSE pg_get_userbyid(acl.grantee) END, "
                "'privilege', acl.privilege_type, 'grantable', acl.is_grantable"
                ") ORDER BY owner.rolname, namespace.nspname, defaults.defaclobjtype, "
                "acl.grantor, acl.grantee, acl.privilege_type) "
                "FROM pg_default_acl AS defaults "
                "JOIN pg_roles AS owner ON owner.oid = defaults.defaclrole "
                "LEFT JOIN pg_namespace AS namespace ON namespace.oid = defaults.defaclnamespace "
                "CROSS JOIN LATERAL aclexplode(defaults.defaclacl) AS acl"
                "), '[]'::json), "
                "'tablespaces', COALESCE((SELECT json_agg(json_build_object("
                "'name', tablespace.spcname, 'owner', pg_get_userbyid(tablespace.spcowner), "
                "'location', pg_tablespace_location(tablespace.oid), "
                "'options', COALESCE(tablespace.spcoptions, ARRAY[]::text[]), "
                "'acl_default', tablespace.spcacl IS NULL, "
                "'acl', COALESCE((SELECT json_agg(json_build_object("
                "'grantor', pg_get_userbyid(acl.grantor), "
                "'grantee', CASE WHEN acl.grantee = 0 THEN NULL "
                "ELSE pg_get_userbyid(acl.grantee) END, "
                "'privilege', acl.privilege_type, 'grantable', acl.is_grantable"
                ") ORDER BY acl.grantor, acl.grantee, acl.privilege_type) "
                "FROM aclexplode(tablespace.spcacl) AS acl), '[]'::json)"
                ") ORDER BY tablespace.spcname) FROM pg_tablespace AS tablespace "
                "WHERE tablespace.spcname NOT IN ('pg_default', 'pg_global')"
                "), '[]'::json)"
                ");",
            ),
            database=self.target.name,
            connect=True,
            application_name=self.snapshot_application_name,
            capture_output=True,
            timeout=self.operation_timeout,
        )
        try:
            dependencies = json.loads(result.stdout)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("could not capture database backup dependencies") from error
        validate_backup_dependencies(dependencies)
        return dependencies

    def verify_global_backup_dependencies(self, expected):
        validate_backup_dependencies(expected)
        required_role_names = {
            role["name"] for role in expected["roles"]
        }
        for membership in expected["memberships"]:
            required_role_names.update(
                membership[field] for field in ("role", "member", "grantor")
            )
        for default_acl in expected["default_acls"]:
            required_role_names.update(
                default_acl[field]
                for field in ("owner", "grantor", "grantee")
                if default_acl[field] is not None
            )
        for tablespace in expected["tablespaces"]:
            required_role_names.add(tablespace["owner"])
            for acl in tablespace["acl"]:
                required_role_names.update(
                    acl[field]
                    for field in ("grantor", "grantee")
                    if acl[field] is not None
                )
        current = self.capture_backup_dependencies(required_role_names)
        current_roles = {role["name"]: role for role in current["roles"]}
        current_tablespaces = {
            tablespace["name"]: tablespace
            for tablespace in current["tablespaces"]
        }
        if any(
            current_roles.get(role["name"]) != role for role in expected["roles"]
        ) or any(
            current_tablespaces.get(tablespace["name"]) != tablespace
            for tablespace in expected["tablespaces"]
        ) or current["memberships"] != expected["memberships"]:
            raise RestoreError(
                "PostgreSQL roles, memberships, or tablespaces do not satisfy the "
                "backup dependency contract"
            )

    def verify_restored_default_acls(self, expected):
        validate_backup_dependencies(expected)
        current = self.capture_backup_dependencies()
        if current["default_acls"] != expected["default_acls"]:
            raise RestoreError(
                "restored PostgreSQL default privileges do not match the backup"
            )

    def drain_database(self, database_oid=None):
        if database_oid is None:
            predicate = f"datname = {sql_literal(self.target.name)}"
        else:
            if type(database_oid) is not int or not 16_384 <= database_oid <= 0xFFFFFFFF:
                raise RestoreError("database drain identity is invalid")
            predicate = f"datid = {database_oid}"
        deadline = time.monotonic() + self.drain_timeout
        timeout_error = (
            "database connections could not be drained within "
            f"{self.drain_timeout} seconds"
        )
        while True:
            remaining_before_deadline(deadline, timeout_error)
            result = self.psql(
                "SELECT pg_terminate_backend(pid) FROM pg_stat_activity "
                f"WHERE {predicate} AND pid <> pg_backend_pid(); "
                "SELECT count(*) FROM pg_stat_activity "
                f"WHERE {predicate} AND pid <> pg_backend_pid();"
                ,
                deadline=deadline,
            )
            lines = [
                line.strip()
                for line in result.stdout.decode().splitlines()
                if line.strip()
            ]
            if lines and lines[-1] == "0":
                return
            wait_for_retry(deadline, timeout_error)

    def create_rollback(self):
        with self.state.create_rollback() as output_descriptor:
            self.target.run_client(
                self.runner,
                "pg_dump",
                (
                    "--format=custom",
                ),
                database=self.target.name,
                connect=True,
                application_name=self.snapshot_application_name,
                stdout=output_descriptor,
                timeout=self.operation_timeout,
            )

    def recreate_database(self, metadata):
        validate_database_metadata(metadata)
        self.drain_database(metadata["oid"])
        database = sql_identifier(self.target.name)
        self.psql(f"DROP DATABASE IF EXISTS {database};")
        if os.environ.get("DOJO_RESTORE_TEST_SLEEP_AFTER_DATABASE_DROP") == "1":
            self.psql("SELECT pg_sleep(300);")

        options = [
            f"OWNER = {sql_identifier(self.maintenance_target.user)}",
            "TEMPLATE = template0",
            f"ENCODING = {sql_literal(metadata['encoding'])}",
            f"LOCALE_PROVIDER = {metadata['locale_provider']}",
            f"LC_COLLATE = {sql_literal(metadata['collate'])}",
            f"LC_CTYPE = {sql_literal(metadata['ctype'])}",
            f"TABLESPACE = {sql_identifier(metadata['tablespace'])}",
            "ALLOW_CONNECTIONS = true",
            "CONNECTION LIMIT = 0",
            "IS_TEMPLATE = false",
            f"OID = {metadata['oid']}",
        ]
        if metadata["locale_provider"] == "builtin":
            options.append(f"BUILTIN_LOCALE = {sql_literal(metadata['locale'])}")
        elif metadata["locale_provider"] == "icu":
            options.append(f"ICU_LOCALE = {sql_literal(metadata['locale'])}")
            if metadata["icu_rules"] is not None:
                options.append(f"ICU_RULES = {sql_literal(metadata['icu_rules'])}")
        if metadata["collation_version"] is not None:
            options.append(
                f"COLLATION_VERSION = {sql_literal(metadata['collation_version'])}"
            )
        self.psql(f"CREATE DATABASE {database} WITH {' '.join(options)};")
        pause_for_test("database-recreated")

    def apply_metadata(self, metadata):
        database = sql_identifier(self.target.name)
        statements = []
        if metadata["comment"] is not None:
            statements.append(
                f"COMMENT ON DATABASE {database} IS {sql_literal(metadata['comment'])}"
            )
        statements.extend(
            f"SECURITY LABEL FOR {sql_identifier(label['provider'])} "
            f"ON DATABASE {database} IS {sql_literal(label['label'])}"
            for label in metadata["security_labels"]
        )
        for setting in metadata["settings"]:
            if setting["role"] is None:
                prefix = f"ALTER DATABASE {database}"
            else:
                prefix = (
                    f"ALTER ROLE {sql_identifier(setting['role'])} "
                    f"IN DATABASE {database}"
                )
            statements.append(
                f"{prefix} SET {sql_identifier(setting['name'])} "
                f"TO {sql_literal(setting['value'])}"
            )
        if statements:
            self.psql(";".join(statements) + ";")

    def restore_archive(self, archive, metadata):
        self.recreate_database(metadata)
        os.lseek(archive.fileno(), archive_payload_offset(archive), os.SEEK_SET)
        self.target.run_client(
            self.runner,
            "pg_restore",
            (
                "--exit-on-error",
                f"--transaction-size={RESTORE_TRANSACTION_SIZE}",
            ),
            database=self.target.name,
            connect=True,
            application_name=self.restore_application_name,
            input_stream=True,
            stdin=archive,
            timeout=self.operation_timeout,
        )
        if hasattr(archive, "manifest"):
            self.verify_restored_default_acls(archive.manifest["dependencies"])
        self.apply_metadata(metadata)
        self.enforce_fenced_acl()

    def restore_rollback(self):
        journal = self.state.load_journal()
        self.verify_journal_identity(journal)
        self.state.set_phase(journal, "rolling_back")
        self.terminate_maintenance_backends()
        self.services.verify_clients_stopped()
        self.drain_database(journal["database"]["oid"])
        with self.state.open_rollback() as rollback:
            journal = self.state.load_journal()
            self.restore_archive(rollback, journal["database"])


def archive_payload_offset(archive):
    offset = getattr(archive, "payload_offset", 0)
    if type(offset) is not int or offset < 0:
        raise RestoreError("backup archive payload offset is invalid")
    return offset


def archive_payload_sha256(archive):
    offset = archive_payload_offset(archive)
    file_stat = os.fstat(archive.fileno())
    if file_stat.st_size <= offset:
        raise RestoreError("backup archive payload is empty")
    digest = hashlib.sha256()
    position = offset
    while position < file_stat.st_size:
        chunk = os.pread(
            archive.fileno(),
            min(1024 * 1024, file_stat.st_size - position),
            position,
        )
        if not chunk:
            raise RestoreError("backup archive changed while being read")
        digest.update(chunk)
        position += len(chunk)
    current_stat = os.fstat(archive.fileno())
    if any(
        getattr(current_stat, field) != getattr(file_stat, field)
        for field in ("st_dev", "st_ino", "st_mode", "st_uid", "st_size", "st_mtime_ns", "st_ctime_ns")
    ):
        raise RestoreError("backup archive changed while being read")
    return digest.hexdigest()


def validate_backup_dependencies(dependencies):
    if not isinstance(dependencies, dict) or set(dependencies) != {
        "roles",
        "memberships",
        "default_acls",
        "tablespaces",
    }:
        raise RestoreError("backup manifest has an invalid dependency contract")
    for field, limit in (
        ("roles", 4096),
        ("memberships", 16384),
        ("default_acls", 16384),
        ("tablespaces", 1024),
    ):
        entries = dependencies[field]
        if not isinstance(entries, list) or len(entries) > limit:
            raise RestoreError("backup manifest has an invalid dependency contract")
    role_fields = {
        "name",
        "superuser",
        "inherit",
        "create_db",
        "create_role",
        "login",
        "replication",
        "bypass_rls",
        "connection_limit",
        "valid_until",
        "config",
    }
    for role in dependencies["roles"]:
        if not isinstance(role, dict) or set(role) != role_fields:
            raise RestoreError("backup manifest has an invalid role dependency")
        validate_text(role["name"], "backup role", limit=1024)
        if any(
            not isinstance(role[field], bool)
            for field in (
                "superuser",
                "inherit",
                "create_db",
                "create_role",
                "login",
                "replication",
                "bypass_rls",
            )
        ):
            raise RestoreError("backup manifest has an invalid role dependency")
        if type(role["connection_limit"]) is not int or not -1 <= role[
            "connection_limit"
        ] <= 2_147_483_647:
            raise RestoreError("backup manifest has an invalid role dependency")
        validate_text(
            role["valid_until"],
            "backup role validity",
            optional=True,
            limit=1024,
        )
        if not isinstance(role["config"], list) or any(
            not isinstance(value, str) or "\x00" in value
            for value in role["config"]
        ):
            raise RestoreError("backup manifest has an invalid role dependency")
    for membership in dependencies["memberships"]:
        if not isinstance(membership, dict) or set(membership) != {
            "role",
            "member",
            "grantor",
            "admin_option",
            "inherit_option",
            "set_option",
        }:
            raise RestoreError("backup manifest has an invalid membership dependency")
        for field in ("role", "member", "grantor"):
            validate_text(membership[field], f"backup membership {field}", limit=1024)
        if any(
            not isinstance(membership[field], bool)
            for field in ("admin_option", "inherit_option", "set_option")
        ):
            raise RestoreError("backup manifest has an invalid membership dependency")
    for default_acl in dependencies["default_acls"]:
        if not isinstance(default_acl, dict) or set(default_acl) != {
            "owner",
            "schema",
            "object_type",
            "grantor",
            "grantee",
            "privilege",
            "grantable",
        }:
            raise RestoreError("backup manifest has an invalid default ACL dependency")
        for field in ("owner", "grantor", "privilege"):
            validate_text(default_acl[field], f"backup default ACL {field}", limit=1024)
        for field in ("schema", "grantee"):
            validate_text(
                default_acl[field],
                f"backup default ACL {field}",
                optional=True,
                limit=1024,
            )
        if default_acl["object_type"] not in {"f", "n", "r", "S", "T"} or not isinstance(
            default_acl["grantable"], bool
        ):
            raise RestoreError("backup manifest has an invalid default ACL dependency")
    for tablespace in dependencies["tablespaces"]:
        if not isinstance(tablespace, dict) or set(tablespace) != {
            "name",
            "owner",
            "location",
            "options",
            "acl_default",
            "acl",
        }:
            raise RestoreError("backup manifest has an invalid tablespace dependency")
        for field in ("name", "owner", "location"):
            validate_text(
                tablespace[field],
                f"backup tablespace {field}",
                allow_empty=field == "location",
                limit=8192,
            )
        if not isinstance(tablespace["options"], list) or any(
            not isinstance(value, str) or "\x00" in value
            for value in tablespace["options"]
        ) or not isinstance(tablespace["acl_default"], bool):
            raise RestoreError("backup manifest has an invalid tablespace dependency")
        if not isinstance(tablespace["acl"], list):
            raise RestoreError("backup manifest has an invalid tablespace dependency")
        for entry in tablespace["acl"]:
            if not isinstance(entry, dict) or set(entry) != {
                "grantor",
                "grantee",
                "privilege",
                "grantable",
            }:
                raise RestoreError("backup manifest has an invalid tablespace ACL")
            validate_text(entry["grantor"], "backup tablespace ACL grantor", limit=1024)
            validate_text(
                entry["grantee"],
                "backup tablespace ACL grantee",
                optional=True,
                limit=1024,
            )
            validate_text(entry["privilege"], "backup tablespace ACL privilege", limit=1024)
            if not isinstance(entry["grantable"], bool):
                raise RestoreError("backup manifest has an invalid tablespace ACL")
    try:
        payload = json.dumps(dependencies, sort_keys=True, separators=(",", ":"))
    except (TypeError, ValueError) as error:
        raise RestoreError("backup manifest has an invalid dependency contract") from error
    if len(payload.encode()) > BACKUP_MANIFEST_LIMIT or "\\u0000" in payload:
        raise RestoreError("backup manifest has an invalid dependency contract")


def validate_backup_manifest(manifest):
    if not isinstance(manifest, dict) or set(manifest) != {
        "version",
        "installation_id",
        "server",
        "database",
        "pg_dump_major",
        "full_dump",
        "archive_sha256",
        "dependencies",
        "signature",
    }:
        raise RestoreError("backup archive has an invalid manifest")
    if manifest["version"] != BACKUP_FORMAT_VERSION:
        raise RestoreError("backup archive has an unsupported format")
    validate_installation_id(manifest["installation_id"])
    validate_server_identity(manifest["server"])
    database = manifest["database"]
    if not isinstance(database, dict) or set(database) != {"name", "metadata"}:
        raise RestoreError("backup archive has invalid source database metadata")
    validate_text(database["name"], "backup database name", limit=1024)
    validate_database_metadata(database["metadata"])
    if (
        type(manifest["pg_dump_major"]) is not int
        or manifest["pg_dump_major"] != SUPPORTED_POSTGRES_MAJOR
        or manifest["full_dump"] is not True
    ):
        raise RestoreError("backup archive is not a supported full database dump")
    for field in ("archive_sha256", "signature"):
        value = manifest[field]
        if (
            not isinstance(value, str)
            or len(value) != 64
            or any(character not in "0123456789abcdef" for character in value)
        ):
            raise RestoreError("backup archive has an invalid manifest identity")
    validate_backup_dependencies(manifest["dependencies"])


def backup_manifest_payload(manifest):
    return json.dumps(
        {field: value for field, value in manifest.items() if field != "signature"},
        sort_keys=True,
        separators=(",", ":"),
    ).encode()


def verify_backup_manifest(
    archive,
    state,
    target,
    current_server_identity,
    *,
    allow_migration,
):
    manifest = archive.manifest
    validate_backup_manifest(manifest)
    actual_digest = archive_payload_sha256(archive)
    if not hmac.compare_digest(actual_digest, manifest["archive_sha256"]):
        raise RestoreError("backup archive checksum does not match its manifest")
    same_installation = manifest["installation_id"] == state.installation_id
    if same_installation:
        signature = hmac.new(
            bytes.fromhex(state.maintenance_secret),
            backup_manifest_payload(manifest),
            hashlib.sha256,
        ).hexdigest()
        if not hmac.compare_digest(signature, manifest["signature"]):
            raise RestoreError("backup archive manifest authentication failed")
    elif not allow_migration:
        raise RestoreError(
            "backup belongs to another installation; use --allow-migration "
            "after verifying its source"
        )
    same_server = (
        manifest["server"]["system_identifier"]
        == current_server_identity["system_identifier"]
    )
    same_database = manifest["database"]["name"] == target.name
    if (not same_server or not same_database) and not allow_migration:
        raise RestoreError(
            "backup source does not match the configured PostgreSQL database"
        )
    if (
        current_server_identity["server_version_num"] // 10_000
        != manifest["pg_dump_major"]
    ):
        raise RestoreError("backup pg_dump major is incompatible with PostgreSQL")


def open_archive(relative_path):
    path = pathlib.PurePosixPath(relative_path)
    if path.is_absolute() or not path.parts or any(
        part in ("", ".", "..") for part in path.parts
    ):
        raise RestoreError("backup path must stay beneath /data/backups")
    try:
        descriptor = os.open(
            BACKUP_DIRECTORY,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
        )
    except OSError as error:
        raise RestoreError("could not open /data/backups") from error
    try:
        for component in path.parts[:-1]:
            next_descriptor = os.open(
                component,
                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=descriptor,
            )
            os.close(descriptor)
            descriptor = next_descriptor
        archive_descriptor = os.open(
            path.parts[-1],
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
            dir_fd=descriptor,
        )
    except OSError as error:
        raise RestoreError(f"could not open backup archive: {relative_path}") from error
    finally:
        os.close(descriptor)
    archive_stat = os.fstat(archive_descriptor)
    if (
        not stat.S_ISREG(archive_stat.st_mode)
        or archive_stat.st_size == 0
        or archive_stat.st_uid != BACKUP_OWNER_UID
        or archive_stat.st_mode & 0o022
    ):
        os.close(archive_descriptor)
        raise RestoreError(
            "backup archive must be a non-empty, root-owned, non-writable regular file"
        )
    archive = os.fdopen(archive_descriptor, "rb")
    try:
        header = os.pread(archive_descriptor, BACKUP_HEADER_SIZE, 0)
        if len(header) != BACKUP_HEADER_SIZE or not header.startswith(BACKUP_MAGIC):
            raise RestoreError("backup archive is missing its source manifest")
        length_offset = len(BACKUP_MAGIC)
        manifest_length = struct.unpack(
            ">I",
            header[length_offset : length_offset + 4],
        )[0]
        if not 0 < manifest_length <= BACKUP_MANIFEST_LIMIT:
            raise RestoreError("backup archive has an invalid manifest size")
        manifest_bytes = header[
            length_offset + 4 : length_offset + 4 + manifest_length
        ]
        try:
            manifest = json.loads(manifest_bytes)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RestoreError("backup archive has an invalid manifest") from error
        validate_backup_manifest(manifest)
        archive.payload_offset = BACKUP_HEADER_SIZE
        archive.manifest = manifest
        if not hmac.compare_digest(
            archive_payload_sha256(archive),
            manifest["archive_sha256"],
        ):
            raise RestoreError("backup archive checksum does not match its manifest")
        os.lseek(archive_descriptor, BACKUP_HEADER_SIZE, os.SEEK_SET)
        return archive
    except BaseException:
        archive.close()
        raise


def sql_literal(value):
    if "\x00" in value:
        raise RestoreError("SQL value contains a null byte")
    return "E'" + value.replace("\\", "\\\\").replace("'", "''") + "'"


def sql_identifier(value):
    if "\x00" in value:
        raise RestoreError("database identifier contains a null byte")
    return '"' + value.replace('"', '""') + '"'


def validate_archive(runner, target, archive, *, timeout=DEFAULT_READY_TIMEOUT):
    offset = archive_payload_offset(archive)
    os.lseek(archive.fileno(), offset, os.SEEK_SET)
    contents = target.run_client(
        runner,
        "pg_restore",
        ("--list",),
        input_stream=True,
        stdin=archive,
        capture_output=True,
        timeout=timeout,
    )
    full_database_entry = False
    for line in contents.stdout.splitlines():
        if not line or line.startswith(b";") or b";" not in line:
            continue
        fields = line.split(b";", 1)[1].lstrip().split(None, 3)
        if len(fields) >= 3 and fields[2] == b"SUBSCRIPTION":
            raise RestoreError("backup archives containing subscriptions are unsupported")
        if len(fields) >= 3 and fields[2] == b"DATABASE":
            full_database_entry = True
    if hasattr(archive, "manifest") and not full_database_entry:
        raise RestoreError("backup archive is not a complete database dump")
    os.lseek(archive.fileno(), offset, os.SEEK_SET)
    target.run_client(
        runner,
        "pg_restore",
        ("--file=/dev/null",),
        input_stream=True,
        stdin=archive,
        stdout=subprocess.DEVNULL,
        timeout=timeout,
    )
    os.lseek(archive.fileno(), offset, os.SEEK_SET)


def open_backup_directory(*, create):
    return open_managed_directory(
        BACKUP_DIRECTORY,
        create=create,
        mode=0o755,
        owner_uid=BACKUP_OWNER_UID,
        exact_mode=False,
        error="backup directory must be root-owned and non-writable",
    )


def trusted_backup_partial(name):
    parts = name.split(".")
    if (
        len(parts) != 5
        or parts[0] != ""
        or parts[4] != "partial"
        or not parts[3].isdecimal()
        or int(parts[3]) <= 0
    ):
        return False
    if parts[1] == "dojo-backup" and parts[2]:
        identifier = parts[2]
    elif parts[1].startswith("db-") and parts[2] == "dump":
        try:
            timestamp, identifier = parts[1][3:].rsplit("-", 1)
            parsed_timestamp = datetime.datetime.strptime(
                timestamp,
                "%Y-%m-%dT%H:%M:%SZ",
            )
        except ValueError:
            return False
        if parsed_timestamp.strftime("%Y-%m-%dT%H:%M:%SZ") != timestamp:
            return False
    else:
        return False
    try:
        parsed_identifier = uuid.UUID(identifier)
    except ValueError:
        return False
    return parsed_identifier.hex == identifier


def cleanup_backup_partials(state):
    if not state.locked:
        raise RestoreError("backup partial cleanup requires the maintenance lock")
    directory_descriptor = open_backup_directory(create=False)
    if directory_descriptor is None:
        return
    removed = False
    try:
        for name in os.listdir(directory_descriptor):
            if not trusted_backup_partial(name):
                continue
            try:
                descriptor = os.open(
                    name,
                    os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                    dir_fd=directory_descriptor,
                )
            except OSError:
                continue
            try:
                partial_stat = os.fstat(descriptor)
                trusted = (
                    stat.S_ISREG(partial_stat.st_mode)
                    and partial_stat.st_uid == BACKUP_OWNER_UID
                    and stat.S_IMODE(partial_stat.st_mode) == 0o600
                )
            finally:
                os.close(descriptor)
            if not trusted:
                continue
            os.unlink(name, dir_fd=directory_descriptor)
            removed = True
        if removed:
            os.fsync(directory_descriptor)
    finally:
        os.close(directory_descriptor)


def write_backup_header(output_descriptor, state, source):
    if not isinstance(source, dict) or set(source) != {
        "server",
        "database",
        "pg_dump_major",
        "dependencies",
    }:
        raise RestoreError("database backup source metadata is invalid")
    with os.fdopen(os.dup(output_descriptor), "rb") as archive:
        archive.payload_offset = BACKUP_HEADER_SIZE
        archive_digest = archive_payload_sha256(archive)
    manifest = {
        "version": BACKUP_FORMAT_VERSION,
        "installation_id": state.installation_id,
        "server": source["server"],
        "database": source["database"],
        "pg_dump_major": source["pg_dump_major"],
        "full_dump": True,
        "archive_sha256": archive_digest,
        "dependencies": source["dependencies"],
        "signature": "0" * 64,
    }
    validate_backup_manifest(manifest)
    manifest["signature"] = hmac.new(
        bytes.fromhex(state.maintenance_secret),
        backup_manifest_payload(manifest),
        hashlib.sha256,
    ).hexdigest()
    manifest_bytes = json.dumps(
        manifest,
        sort_keys=True,
        separators=(",", ":"),
    ).encode()
    if len(manifest_bytes) > BACKUP_MANIFEST_LIMIT:
        raise RestoreError("database backup manifest is too large")
    header = (
        BACKUP_MAGIC
        + struct.pack(">I", len(manifest_bytes))
        + manifest_bytes
    ).ljust(BACKUP_HEADER_SIZE, b"\x00")
    position = 0
    while position < len(header):
        written = os.pwrite(output_descriptor, header[position:], position)
        if written == 0:
            raise RestoreError("database backup manifest could not be written")
        position += written
    return manifest


def capture_pg_dump_major(runner, target, *, timeout):
    result = target.run_client(
        runner,
        "pg_dump",
        ("--version",),
        capture_output=True,
        timeout=timeout,
    )
    try:
        output = result.stdout.decode().strip()
        prefix = "pg_dump (PostgreSQL) "
        if not output.startswith(prefix):
            raise ValueError
        version = output[len(prefix) :].split(None, 1)[0]
        major = int(version.split(".", 1)[0])
    except (UnicodeDecodeError, IndexError, ValueError) as error:
        raise RestoreError("could not identify the PostgreSQL pg_dump client") from error
    if major != SUPPORTED_POSTGRES_MAJOR:
        raise RestoreError(
            f"PostgreSQL pg_dump {SUPPORTED_POSTGRES_MAJOR} is required"
        )
    return major


def create_backup(
    runner,
    target,
    state,
    source,
    *,
    timeout=DEFAULT_COLD_START_TIMEOUT,
):
    if not state.locked:
        raise RestoreError("database backup requires the maintenance lock")
    directory_descriptor = open_backup_directory(create=True)
    timestamp = datetime.datetime.now(datetime.timezone.utc).strftime(
        "%Y-%m-%dT%H:%M:%SZ"
    )
    unique_id = uuid.uuid4().hex
    filename = f"db-{timestamp}-{unique_id}.dump"
    temporary_name = f"{BACKUP_PARTIAL_PREFIX}{unique_id}.{os.getpid()}.partial"
    output_descriptor = None
    renamed = False
    published = False
    try:
        output_descriptor = os.open(
            temporary_name,
            os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=directory_descriptor,
        )
        os.fchmod(output_descriptor, 0o600)
        position = 0
        empty_header = b"\x00" * BACKUP_HEADER_SIZE
        while position < len(empty_header):
            written = os.write(output_descriptor, empty_header[position:])
            if written == 0:
                raise RestoreError("database backup header could not be reserved")
            position += written
        pause_for_test("backup-created")
        target.run_client(
            runner,
            "pg_dump",
            ("--format=custom", "--create"),
            database=target.name,
            connect=True,
            application_name=application_name(
                BACKUP_APPLICATION_NAME,
                getattr(state, "installation_id", None)
                or "0" * INSTALLATION_ID_LENGTH,
            ),
            stdout=output_descriptor,
            timeout=timeout,
        )
        output_stat = os.fstat(output_descriptor)
        if (
            output_stat.st_size <= BACKUP_HEADER_SIZE
            or output_stat.st_uid != BACKUP_OWNER_UID
            or stat.S_IMODE(output_stat.st_mode) != 0o600
        ):
            raise RestoreError("database backup output is invalid")
        manifest = write_backup_header(output_descriptor, state, source)
        os.fsync(output_descriptor)
        with os.fdopen(os.dup(output_descriptor), "rb") as archive:
            archive.payload_offset = BACKUP_HEADER_SIZE
            archive.manifest = manifest
            validate_archive(runner, target, archive, timeout=timeout)
        os.replace(
            temporary_name,
            filename,
            src_dir_fd=directory_descriptor,
            dst_dir_fd=directory_descriptor,
        )
        renamed = True
        os.fsync(directory_descriptor)
        published = True
    finally:
        if output_descriptor is not None:
            os.close(output_descriptor)
        if not published:
            for failed_name in (filename if renamed else temporary_name,):
                try:
                    os.unlink(failed_name, dir_fd=directory_descriptor)
                except FileNotFoundError:
                    pass
            os.fsync(directory_descriptor)
        os.close(directory_descriptor)
    return filename


def restore_services_and_cleanup(state, journal, services, exposed_phase=None):
    services.restore_snapshot(journal["services"])
    if journal["services"]["ctfd"]["running"]:
        services.wait_external_http()
    if exposed_phase is not None:
        state.set_phase(journal, exposed_phase)
    state.cleanup()


def deactivate_maintenance_before_exposure(state, journal, database):
    state.set_maintenance(journal, "deactivating")
    pause_for_test("maintenance-role-deactivating")
    deactivate_maintenance_with_application(database)
    pause_for_test("journal-maintenance-role-deactivated")
    state.set_maintenance(journal, "inactive")


def activate_maintenance_after_gating(state, journal, database, services):
    database.use_application_target()
    database.verify_journal_identity(journal)
    services.gate_restarts(journal["services"])
    services.stop_clients(journal["services"])
    database.verify_journal_identity(journal)
    database.terminate_maintenance_backends()
    database.activate_maintenance_role()
    state.set_maintenance(journal, "active")


def expose_services(state, journal, database, services, exposed_phase):
    database.release_fence(journal["database"], journal["application_role"])
    deactivate_maintenance_before_exposure(state, journal, database)
    restore_services_and_cleanup(state, journal, services, exposed_phase)


def complete_rollback(state, database, services):
    database.restore_rollback()
    journal = state.load_journal()
    state.set_phase(journal, "rollback_warming")
    database.verify_fence_integrity()
    services.warm_cache()
    database.verify_fence_integrity()
    state.set_phase(journal, "rollback_validating")
    services.validate_application()
    database.verify_fence_integrity()
    state.set_phase(journal, "rolled_back")
    expose_services(
        state,
        journal,
        database,
        services,
        "rolled_back_exposed",
    )


def verify_recovery_journal_header(state, journal, database, services):
    if journal["version"] == 6:
        if journal["installation_id"] != state.installation_id:
            raise RestoreError(
                "pending startup journal belongs to a different installation"
            )
        database.verify_configured_startup_target(journal["target"])
        services.require_supported_snapshot(journal["services"])
        return
    if journal["version"] == 1:
        raise RestoreError(
            "version-one restore journals are not bound to a database target and "
            "require manual intervention"
        )
    if journal["version"] in {3, 4}:
        raise RestoreError(
            "restore journal predates maintenance-role provenance and requires "
            "manual intervention"
        )
    if (
        journal["version"] == 5
        and journal["installation_id"] != state.installation_id
    ):
        raise RestoreError(
            "pending restore journal belongs to a different installation"
        )
    database.verify_configured_target(journal["target"])
    services.require_supported_snapshot(journal["services"])


def deactivate_maintenance_with_application(database):
    database.use_application_target()
    database.wait_ready()
    database.verify_maintenance_role_deactivatable()
    database.terminate_maintenance_backends()
    database.deactivate_maintenance_role()
    database.terminate_maintenance_backends()


def prepare_restore_recovery(state, database, services):
    journal = state.load_journal()
    if journal is None:
        database_state = services.snapshot_database_for_startup()
        if database_state["running"]:
            deactivate_maintenance_with_application(database)
            return
        snapshot = services.snapshot_for_startup()
        if snapshot is None:
            return
        journal = {
            "version": 6,
            "kind": "startup",
            "services": snapshot,
            "installation_id": state.installation_id,
            "database": database_state,
            "target": database.application_target.configuration(),
        }
        state.write_journal(journal)
    verify_recovery_journal_header(state, journal, database, services)
    services.verify_identities(journal["services"])
    services.gate_restarts(journal["services"])
    services.stop_clients(journal["services"])


def recover_inactive_maintenance(state, journal, database, services):
    database.use_application_target()
    database.wait_ready()
    database.verify_journal_identity(journal)
    database.verify_recreation_privileges()
    deactivate_maintenance_with_application(database)
    pause_for_test("journal-maintenance-role-deactivated")
    if journal["maintenance"] != "inactive":
        state.set_maintenance(journal, "inactive")
    services.cleanup_private_validation()
    services.verify_identities(journal["services"])
    exposed_phase = None
    if journal["phase"] in FORWARD_TERMINAL_PHASES:
        exposed_phase = "committed_exposed"
    elif journal["phase"] in ROLLBACK_TERMINAL_PHASES:
        exposed_phase = "rolled_back_exposed"
    restore_services_and_cleanup(state, journal, services, exposed_phase)


def recover_restore(state, database, services):
    journal = state.load_journal()
    if journal is None:
        if services.database_client_available():
            deactivate_maintenance_with_application(database)
        try:
            state._unlink_trusted("rollback.dump")
            state._fsync_directory()
        except FileNotFoundError:
            pass
        return
    verify_recovery_journal_header(state, journal, database, services)
    if journal["version"] == 6:
        services.verify_identities(journal["services"])
        services.gate_restarts(journal["services"])
        services.stop_clients(journal["services"])
        services.verify_startup_database_identity(journal["database"])
        services.ensure_database_client()
        database_state = services.bind_startup_database_identity(journal["database"])
        if database_state != journal["database"]:
            journal["database"] = database_state
            state.write_journal(journal)
        services.verify_startup_database_identity(journal["database"])
        deactivate_maintenance_with_application(database)
        pause_for_test("startup-maintenance-role-deactivated")
        services.verify_identities(journal["services"])
        restore_services_and_cleanup(state, journal, services)
        return
    services.ensure_database_client()
    if journal["version"] == 2:
        database.use_application_target()
        database.wait_ready()
        database.verify_journal_identity(journal)
        database.verify_recreation_privileges()
        application_role = database.verify_application_role()
        database.verify_maintenance_role_reusable()
        journal = {
            **journal,
            "version": 5,
            "installation_id": state.installation_id,
            "application_role": application_role,
            "maintenance": "activating",
        }
        state.write_journal(journal)
        activate_maintenance_after_gating(
            state,
            journal,
            database,
            services,
        )
    if journal["maintenance"] == "activating":
        database.use_application_target()
        database.wait_ready()
        database.verify_journal_identity(journal)
        database.verify_recreation_privileges()
        recover_inactive_maintenance(state, journal, database, services)
        return
    if journal["maintenance"] in {"deactivating", "inactive"}:
        recover_inactive_maintenance(state, journal, database, services)
        return
    database.use_maintenance_target()
    database.verify_maintenance_role(
        database.capture_maintenance_role(target=database.maintenance_target),
        login=True,
    )
    database.wait_ready()
    database.verify_journal_identity(journal)
    database.verify_recreation_privileges()
    database.terminate_maintenance_backends()
    services.verify_identities(journal["services"])
    services.cleanup_private_validation()
    services.verify_identities(journal["services"])
    services.gate_restarts(journal["services"])
    services.stop_clients(journal["services"])
    database.verify_journal_identity(journal)
    database.terminate_maintenance_backends()
    if journal["phase"] in PRE_MUTATION_PHASES:
        database.release_fence(journal["database"], journal["application_role"])
        deactivate_maintenance_before_exposure(state, journal, database)
        restore_services_and_cleanup(state, journal, services)
        return
    if journal["phase"] in FORWARD_TERMINAL_PHASES | ROLLBACK_TERMINAL_PHASES:
        database.establish_fence(
            journal["database"], journal["application_role"]
        )
        services.warm_cache()
        database.verify_fence_integrity()
        services.validate_application()
        database.verify_fence_integrity()
        exposed_phase = (
            "committed_exposed"
            if journal["phase"] in FORWARD_TERMINAL_PHASES
            else "rolled_back_exposed"
        )
        expose_services(state, journal, database, services, exposed_phase)
        return
    database.establish_fence(journal["database"], journal["application_role"])
    complete_rollback(state, database, services)


def install_interrupt_handlers(runner, operation):
    def interrupt(signum, _frame):
        runner.interrupt()
        raise RestoreInterrupted(f"{operation} interrupted by signal {signum}")

    signal.signal(signal.SIGINT, interrupt)
    signal.signal(signal.SIGTERM, interrupt)


def restore(filename=None, *, prepare_recovery_only=False, allow_migration=False):
    runner = CommandRunner()
    target = DatabaseTarget.from_environment()
    services = DockerServices(runner, target)
    install_interrupt_handlers(runner, "restore")

    with RestoreState() as state:
        database = DatabaseRestore(runner, state, services, target)
        if prepare_recovery_only:
            prepare_restore_recovery(state, database, services)
            return
        recover_restore(state, database, services)
        cleanup_backup_partials(state)
        if filename is None:
            return
        with open_archive(filename) as archive:
            database.verify_maintenance_role_reusable()
            database.verify_recreation_privileges()
            target_identity = database.capture_target()
            verify_backup_manifest(
                archive,
                state,
                target,
                target_identity["server"],
                allow_migration=allow_migration,
            )
            validate_archive(
                runner,
                target,
                archive,
                timeout=services.cold_start_timeout,
            )
            database.verify_global_backup_dependencies(
                archive.manifest["dependencies"]
            )
            database.verify_fence_available()
            database.preflight_recreation()
            database.acquire_cluster_claims(target_identity["server"])
            application_role = database.verify_application_role()
            pause_for_test("after-initial-preflight")
            snapshot = services.snapshot()
            metadata = database.capture_metadata()
            journal = {
                "version": 5,
                "phase": "snapshotting",
                "services": snapshot,
                "database": metadata,
                "target": target_identity,
                "installation_id": state.installation_id,
                "application_role": application_role,
                "maintenance": "activating",
            }
            state.write_journal(journal)
            try:
                activate_maintenance_after_gating(
                    state,
                    journal,
                    database,
                    services,
                )
                database.verify_journal_identity(journal)
                database.terminate_maintenance_backends()
                database.establish_fence(
                    metadata,
                    application_role,
                    preflight=True,
                )
                database.verify_global_backup_dependencies(
                    archive.manifest["dependencies"]
                )
                state.set_phase(journal, "fenced")
                database.create_rollback()
                with state.open_rollback() as rollback:
                    validate_archive(
                        runner,
                        database.target,
                        rollback,
                        timeout=services.cold_start_timeout,
                    )
                state.set_phase(journal, "ready")
                database.drain_database(metadata["oid"])
                state.set_phase(journal, "restoring")
                database.restore_archive(archive, metadata)
                state.set_phase(journal, "restored")
                state.set_phase(journal, "warming")
                database.verify_fence_integrity()
                services.warm_cache()
                database.verify_fence_integrity()
                state.set_phase(journal, "validating")
                fail_after_validation = (
                    os.environ.get("DOJO_RESTORE_TEST_FAIL_APPLICATION_VALIDATION")
                    == "1"
                )
                services.validate_application(
                    fail_after_validation=fail_after_validation
                )
                database.verify_fence_integrity()
                state.set_phase(journal, "committed")
                expose_services(
                    state,
                    journal,
                    database,
                    services,
                    "committed_exposed",
                )
            except BaseException:
                try:
                    recover_restore(state, database, services)
                except BaseException as recovery_error:
                    raise RestoreError(
                        f"restore failed and recovery remains pending: {recovery_error}"
                    ) from recovery_error
                raise


def backup():
    runner = CommandRunner()
    target = DatabaseTarget.from_environment()
    install_interrupt_handlers(runner, "backup")
    with RestoreState() as state:
        if state.load_journal() is not None:
            raise RestoreError(
                "database backup refused because restore recovery is pending"
            )
        cleanup_backup_partials(state)
        services = type(
            "BackupServices",
            (),
            {
                "ready_timeout": configured_timeout(
                    "DOJO_RESTORE_READY_TIMEOUT_SECONDS",
                    DEFAULT_READY_TIMEOUT,
                ),
                "cold_start_timeout": configured_timeout(
                    "DOJO_RESTORE_COLD_START_TIMEOUT_SECONDS",
                    DEFAULT_COLD_START_TIMEOUT,
                ),
                "target": target,
            },
        )()
        database = DatabaseRestore(runner, state, services, target)
        database.wait_ready()
        database.verify_recreation_privileges()
        target_identity = database.capture_target()
        database.verify_maintenance_role_reusable()
        database.verify_exclusive_cluster_topology()
        metadata = database.capture_metadata()
        dependencies = database.capture_backup_dependencies()
        pg_dump_major = capture_pg_dump_major(
            runner,
            target,
            timeout=services.ready_timeout,
        )
        database.acquire_cluster_claims(target_identity["server"])
        source = {
            "server": target_identity["server"],
            "database": {
                "name": target.name,
                "metadata": metadata,
            },
            "pg_dump_major": pg_dump_major,
            "dependencies": dependencies,
        }
        filename = create_backup(
            runner,
            target,
            state,
            source,
            timeout=configured_timeout(
                "DOJO_RESTORE_COLD_START_TIMEOUT_SECONDS",
                DEFAULT_COLD_START_TIMEOUT,
            ),
        )
    print(f"Created backup at {BACKUP_DIRECTORY / filename}")


def shutdown():
    runner = CommandRunner()
    install_interrupt_handlers(runner, "shutdown")
    with RestoreState() as state:
        pending_restore = state.load_journal() is not None
        runner.run(
            ["dojo", "compose", "stop" if pending_restore else "down"],
            timeout=configured_timeout(
                "DOJO_RESTORE_COLD_START_TIMEOUT_SECONDS",
                DEFAULT_COLD_START_TIMEOUT,
            ),
        )


def validate_target_configuration():
    DatabaseTarget.from_environment()


def parse_arguments():
    parser = argparse.ArgumentParser(prog="dojo database maintenance")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--recover", action="store_true")
    mode.add_argument("--prepare-recovery", action="store_true")
    mode.add_argument("--backup", action="store_true")
    mode.add_argument("--shutdown", action="store_true")
    mode.add_argument("--validate-target", action="store_true")
    parser.add_argument("filename", nargs="?")
    parser.add_argument("--allow-migration", action="store_true")
    arguments = parser.parse_args()
    if (
        arguments.recover
        or arguments.prepare_recovery
        or arguments.backup
        or arguments.shutdown
        or arguments.validate_target
    ) and arguments.filename:
        parser.error("maintenance modes do not accept a backup filename")
    if (
        not arguments.recover
        and not arguments.prepare_recovery
        and not arguments.backup
        and not arguments.shutdown
        and not arguments.validate_target
        and not arguments.filename
    ):
        parser.error("a backup filename is required")
    if arguments.allow_migration and (
        arguments.recover
        or arguments.prepare_recovery
        or arguments.backup
        or arguments.shutdown
        or arguments.validate_target
    ):
        parser.error("--allow-migration requires a backup filename")
    return arguments


def main():
    arguments = parse_arguments()
    try:
        if arguments.backup:
            backup()
        elif arguments.shutdown:
            shutdown()
        elif arguments.validate_target:
            validate_target_configuration()
        else:
            restore(
                None if arguments.recover or arguments.prepare_recovery else arguments.filename,
                prepare_recovery_only=arguments.prepare_recovery,
                allow_migration=arguments.allow_migration,
            )
    except RestoreError as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
