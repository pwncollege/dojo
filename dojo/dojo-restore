def maintenance_role_provenance(installation_id, maintenance_secret):
    validate_installation_id(installation_id)
    if (
        not isinstance(maintenance_secret, str)
        or len(maintenance_secret) != MAINTENANCE_SECRET_LENGTH
        or any(character not in "0123456789abcdef" for character in maintenance_secret)
    ):
        raise RestoreError("restore maintenance secret is invalid")
    digest = hmac.new(
        bytes.fromhex(maintenance_secret),
        f"maintenance-role:{installation_id}".encode(),
        hashlib.sha256,
    ).hexdigest()
    return f"{MAINTENANCE_ROLE_PROVENANCE_PREFIX}:{installation_id}:{digest}"


def cluster_claim_role_name(kind, server_identity, resource):
    if kind not in {"database", "role"}:
        raise RestoreError("database cluster claim kind is invalid")
    validate_server_identity(server_identity)
    validate_text(resource, "cluster claim resource", limit=1024)
    digest = hashlib.sha256(
        (
            f"{server_identity['system_identifier']}\0{kind}\0{resource}"
        ).encode()
    ).hexdigest()[:32]
    return f"dojo_restore_claim_{kind[0]}_{digest}"


