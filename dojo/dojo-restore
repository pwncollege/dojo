DEFAULT_READY_TIMEOUT = 300
DEFAULT_COLD_START_TIMEOUT = 21_600
MAXIMUM_TIMEOUT = 604_800
COMMAND_TIMEOUT_GRACE = 2


class RestoreError(RuntimeError):
    pass


class RestoreInterrupted(RestoreError):
    pass


class LoopbackHTTPSConnection(http.client.HTTPSConnection):
    def connect(self):
        self.sock = socket.create_connection(
            ("127.0.0.1", self.port),
            self.timeout,
            self.source_address,
        )
        try:
            self.sock = self._context.wrap_socket(
                self.sock,
                server_hostname=self.host,
            )
        except BaseException:
            self.sock.close()
            self.sock = None
            raise


def validate_server_identity(identity):
    if not isinstance(identity, dict) or set(identity) != {
        "system_identifier",
        "server_version_num",
    }:
        raise RestoreError("restore journal has an invalid PostgreSQL server identity")
    system_identifier = identity["system_identifier"]
    if (
        not isinstance(system_identifier, str)
        or not system_identifier.isdecimal()
        or not 1 <= int(system_identifier) <= 0xFFFFFFFFFFFFFFFF
    ):
        raise RestoreError("restore journal has an invalid PostgreSQL system identifier")
    if (
        type(identity["server_version_num"]) is not int
        or not 90_000 <= identity["server_version_num"] <= 9_999_999
    ):
        raise RestoreError("restore journal has an invalid PostgreSQL server version")


def validate_database_target(target):
    if not isinstance(target, dict) or set(target) != {
        "host",
        "port",
        "name",
        "user",
        "server",
    }:
        raise RestoreError("restore journal has an invalid database target")
    for field in ("host", "name", "user"):
        validate_text(target[field], f"target {field}", limit=1024)
    if type(target["port"]) is not int or not 1 <= target["port"] <= 65535:
        raise RestoreError("restore journal has an invalid database target port")
    validate_server_identity(target["server"])


def validate_application_role(role):
    if not isinstance(role, dict) or set(role) != {"name", "login"}:
        raise RestoreError("restore journal has an invalid application role")
    validate_text(role["name"], "application role", limit=1024)
    if not isinstance(role["login"], bool):
        raise RestoreError("restore journal has an invalid application role login state")


def validate_text(value, field, *, optional=False, allow_empty=False, limit=8192):
    if optional and value is None:
        return
    if (
        not isinstance(value, str)
        or (not value and not allow_empty)
        or "\x00" in value
        or len(value.encode()) > limit
    ):
        raise RestoreError(f"restore journal has invalid database {field}")


def validate_database_metadata(metadata):
    if not isinstance(metadata, dict) or set(metadata) != {
        "oid",
        "owner",
        "encoding",
        "locale_provider",
        "collate",
        "ctype",
        "locale",
        "icu_rules",
        "collation_version",
        "tablespace",
        "allow_connections",
        "is_template",
        "connection_limit",
        "acl_default",
        "acl",
        "comment",
        "security_labels",
        "settings",
    }:
        raise RestoreError("restore journal has invalid database metadata")
    if type(metadata["oid"]) is not int or not 16_384 <= metadata["oid"] <= 0xFFFFFFFF:
        raise RestoreError("restore journal has invalid database oid")
    for field in ("owner", "encoding", "collate", "ctype", "tablespace"):
        validate_text(metadata[field], field, limit=1024)
    if metadata["locale_provider"] not in {"builtin", "icu", "libc"}:
        raise RestoreError("restore journal has invalid database locale provider")
    validate_text(metadata["locale"], "locale", optional=True, limit=8192)
    validate_text(
        metadata["icu_rules"],
        "icu rules",
        optional=True,
        allow_empty=True,
        limit=32768,
    )
    validate_text(
        metadata["collation_version"],
        "collation version",
        optional=True,
        limit=8192,
    )
    if metadata["locale_provider"] in {"builtin", "icu"} and metadata["locale"] is None:
        raise RestoreError("restore journal is missing the database locale")
    if metadata["locale_provider"] != "icu" and metadata["icu_rules"] is not None:
        raise RestoreError("restore journal has unexpected database ICU rules")
    if not isinstance(metadata["allow_connections"], bool) or not isinstance(
        metadata["is_template"], bool
    ):
        raise RestoreError("restore journal has invalid database lifecycle metadata")
    if (
        type(metadata["connection_limit"]) is not int
        or not -1 <= metadata["connection_limit"] <= 2_147_483_647
    ):
        raise RestoreError("restore journal has invalid database connection limit")
    if not isinstance(metadata["acl_default"], bool):
        raise RestoreError("restore journal has invalid database ACL state")
    if not isinstance(metadata["acl"], list) or len(metadata["acl"]) > 4096:
        raise RestoreError("restore journal has invalid database ACL")
    for entry in metadata["acl"]:
        if not isinstance(entry, dict) or set(entry) != {
            "grantor",
            "grantee",
            "privilege",
            "grantable",
        }:
            raise RestoreError("restore journal has invalid database ACL entry")
        validate_text(entry["grantor"], "ACL grantor", limit=1024)
        validate_text(entry["grantee"], "ACL grantee", optional=True, limit=1024)
        if entry["privilege"] not in {"CONNECT", "CREATE", "TEMPORARY"} or not isinstance(
            entry["grantable"], bool
        ):
            raise RestoreError("restore journal has invalid database ACL privilege")
        if entry["grantor"] != metadata["owner"] or (
            entry["grantee"] is None and entry["grantable"]
        ):
            raise RestoreError("restore journal has unsupported database ACL grantor")
    if metadata["acl_default"] and metadata["acl"]:
        raise RestoreError("restore journal has inconsistent database ACL metadata")
    validate_text(
        metadata["comment"],
        "comment",
        optional=True,
        allow_empty=True,
        limit=32768,
    )
    if (
        not isinstance(metadata["security_labels"], list)
        or len(metadata["security_labels"]) > 128
    ):
        raise RestoreError("restore journal has invalid database security labels")
    for label in metadata["security_labels"]:
        if not isinstance(label, dict) or set(label) != {"provider", "label"}:
            raise RestoreError("restore journal has invalid database security label")
        validate_text(label["provider"], "security label provider", limit=1024)
        validate_text(label["label"], "security label", allow_empty=True, limit=32768)
    if not isinstance(metadata["settings"], list) or len(metadata["settings"]) > 4096:
        raise RestoreError("restore journal has invalid database settings")
    for setting in metadata["settings"]:
        if not isinstance(setting, dict) or set(setting) != {"role", "name", "value"}:
            raise RestoreError("restore journal has invalid database setting")
        validate_text(setting["role"], "setting role", optional=True, limit=1024)
        validate_text(setting["name"], "setting name", limit=1024)
        if not isinstance(setting["value"], str) or "\x00" in setting["value"] or len(
            setting["value"].encode()
        ) > 32768:
            raise RestoreError("restore journal has invalid database setting value")


def configured_timeout(name, default):
    value = os.environ.get(name, str(default))
    try:
        timeout = int(value)
    except ValueError as error:
        raise RestoreError(f"{name} must be an integer number of seconds") from error
    if not 1 <= timeout <= MAXIMUM_TIMEOUT:
        raise RestoreError(f"{name} must be between 1 and {MAXIMUM_TIMEOUT} seconds")
    return timeout


def remaining_before_deadline(deadline, error):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise RestoreError(error)
    return remaining


def wait_for_retry(deadline, error):
    remaining = remaining_before_deadline(deadline, error)
    time.sleep(min(1, remaining))


