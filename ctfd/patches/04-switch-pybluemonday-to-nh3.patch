+HTML_ALLOWED_ATTRIBUTES["*"] = set()
+for attribute in SAFE_ATTRS:
+    HTML_ALLOWED_ATTRIBUTES["*"].add(attribute)
+
+HTML_ALLOWED_ATTRIBUTES["*"].add("class")
+
+
+URL_ATTRIBUTES = {"action", "background", "cite", "href", "longdesc", "poster", "src", "usemap"}
+URL_IGNORED_CHARACTERS = str.maketrans("", "", "\t\r\n")
+URL_LEADING_CHARACTERS = "".join(chr(codepoint) for codepoint in range(0x21))
+
+
+def filter_attribute(tag, attribute, value):
+    normalized_value = value.translate(URL_IGNORED_CHARACTERS)
+    normalized_value = normalized_value.lstrip(URL_LEADING_CHARACTERS).lower()
+    if attribute in URL_ATTRIBUTES and normalized_value.startswith("data:"):
+        if tag != "img" or attribute != "src" or not normalized_value.startswith("data:image/"):
+            return None
+    return value
+
+
+SANITIZER = Cleaner(
+    tags=ALLOWED_TAGS,
+    attributes=HTML_ALLOWED_ATTRIBUTES,
+    attribute_filter=filter_attribute,
+    link_rel="noopener noreferrer nofollow",
+    strip_comments=False,
+    generic_attribute_prefixes={"data-", "aria-"},
+    url_schemes={"data", "http", "https", "tel", "mailto"},
+)
